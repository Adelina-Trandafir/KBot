<Project Sdk="Microsoft.NET.Sdk">

  <!-- K-BOT tray application = the SIGNER EDITION (slices TRAY-01, TRAY-02). A program of its own for the people who only sign:
       it lives in the notification area, checks every few minutes whether the logged-in user has documents waiting for the
       signature, shows a list above the clock, and a click opens the signing window ITSELF (DirectorForm / DeSemnatRestransForm,
       taken from KBot.App.dll; there is no KBot.App.exe in its package). It has its own package, version and update channel:
       push-tray.ps1 publishes it (framework-dependent folder, KBot.Tray.exe the only .exe) and the tray replaces its own files. -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <RootNamespace>KBot.Tray</RootNamespace>
    <AssemblyName>KBot.Tray</AssemblyName>
    <UseWindowsForms>true</UseWindowsForms>
    <MyType>Empty</MyType>
    <StartupObject>KBot.Tray.Program</StartupObject>
    <OptionStrict>On</OptionStrict>
    <OptionExplicit>On</OptionExplicit>
    <OptionInfer>On</OptionInfer>
    <OptionCompare>Binary</OptionCompare>
    <ApplicationIcon>..\KBot.App\kbot.ico</ApplicationIcon>
  </PropertyGroup>

  <!-- K-BOT component version.
       FileVersion: bump MANUALLY, only when THIS project changes.
       AssemblyVersion: keep STABLE. -->
  <PropertyGroup>
    <FileVersion>1.0.0.0</FileVersion>
    <AssemblyVersion>1.0.0.0</AssemblyVersion>
  </PropertyGroup>

  <ItemGroup>
    <Import Include="System.Drawing" />
    <Import Include="System.Windows.Forms" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\KBot.Api\KBot.Api.vbproj" />
    <ProjectReference Include="..\KBot.Common\KBot.Common.vbproj" />
    <ProjectReference Include="..\KBot.Domain\KBot.Domain.vbproj" />
    <ProjectReference Include="..\KBot.Theming\KBot.Theming.vbproj" />
    <ProjectReference Include="..\KBot.Controls\KBot.Controls.vbproj" />
    <!-- The signing windows. KBot.App is an exe project: only its KBot.App.dll is used (push-tray.ps1 drops every other .exe). -->
    <ProjectReference Include="..\KBot.App\KBot.App.vbproj" />
  </ItemGroup>

</Project>
