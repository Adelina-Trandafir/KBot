<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0-windows</TargetFramework>
    <RootNamespace>KBot.EFactura</RootNamespace>
    <AssemblyName>KBot.EFactura</AssemblyName>
    <UseWindowsForms>true</UseWindowsForms>
    <OptionStrict>On</OptionStrict>
    <OptionExplicit>On</OptionExplicit>
    <OptionInfer>On</OptionInfer>
    <OptionCompare>Binary</OptionCompare>
    <!-- BouncyCastle 1.8.9 vine TRANSITIV prin iTextSharp (vezi KBot.Xfa.vbproj, aceeasi motivare). -->
    <NoWarn>$(NoWarn);NU1701</NoWarn>
  </PropertyGroup>

  <!-- Versiune componentă K-BOT.
       FileVersion: incrementează MANUAL, doar când SE SCHIMBĂ acest proiect. Stă la baza
       comparației din manifestul de update.
       AssemblyVersion: ține-l STABIL. Incrementează doar la o schimbare de interfață care
       rupe compatibilitatea și, când o faci, livrează setul COMPLET, niciodată parțial. -->
  <PropertyGroup>
    <FileVersion>1.14.2.8</FileVersion>
    <AssemblyVersion>1.0.0.0</AssemblyVersion>
  </PropertyGroup>

  <!-- Slice 00EF-05. E-Factura: biblioteca ferestrelor și a pașilor E-Factura, folosită DIRECT de KBot.App
       (același proces, aceeași sesiune, aceeași temă, aceleași jurnale). Referințele merg doar spre
       KBot.App -> KBot.EFactura, niciodată înapoi: tot ce are nevoie din fereastra principală (unitatea,
       poarta de re-autentificare) îi e dat ca argument.
       Controalele noi, dacă apar, se pun în KBot.Controls\<Familie>\, nu aici. -->
  <ItemGroup>
    <!-- Slice 00EF-09: the PDF of the classic invoice and of the ANAF error (FacturaPdf); same version as KBot.Xfa. -->
    <PackageReference Include="iTextSharp" Version="5.5.13.3" NoWarn="NU1701" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\KBot.Domain\KBot.Domain.vbproj" />
    <ProjectReference Include="..\KBot.Common\KBot.Common.vbproj" />
    <ProjectReference Include="..\KBot.Api\KBot.Api.vbproj" />
    <ProjectReference Include="..\KBot.Theming\KBot.Theming.vbproj" />
    <ProjectReference Include="..\KBot.Controls\KBot.Controls.vbproj" />
  </ItemGroup>

	<ItemGroup>
		<Compile Update="Forms\FacturiVanzareForm.Trimitere.vb">
			<DependentUpon>FacturiForm.vb</DependentUpon>
		</Compile>
		<Compile Update="My Project\Resources.Designer.vb">
		  <DesignTime>True</DesignTime>
		  <AutoGen>True</AutoGen>
		  <DependentUpon>Resources.resx</DependentUpon>
		</Compile>
	</ItemGroup>

	<ItemGroup>
	  <EmbeddedResource Update="My Project\Resources.resx">
	    <CustomToolNamespace>My.Resources</CustomToolNamespace>
	    <Generator>VbMyResourcesResXFileCodeGenerator</Generator>
	    <LastGenOutput>Resources.Designer.vb</LastGenOutput>
	  </EmbeddedResource>
	</ItemGroup>

  <ItemGroup>
    <Compile Update="Views\FacturiCumparare\FacturiCumparareDetaliiView.vb;Views\FacturiCumparare\FacturiCumparareReceptiiEditorView.vb">
      <SubType>UserControl</SubType>
    </Compile>
    <Compile Update="Views\FacturiCumparare\FacturiCumparareDetaliiView.Designer.vb">
      <DependentUpon>FacturiCumparareDetaliiView.vb</DependentUpon>
    </Compile>
    <Compile Update="Views\FacturiCumparare\FacturiCumparareReceptiiEditorView.Designer.vb">
      <DependentUpon>FacturiCumparareReceptiiEditorView.vb</DependentUpon>
    </Compile>
    <Compile Update="Views\FacturiCumparare\FacturiCumparareReceptieNouaView.vb">
      <SubType>UserControl</SubType>
    </Compile>
    <Compile Update="Views\FacturiCumparare\FacturiCumparareReceptieNouaView.Designer.vb">
      <DependentUpon>FacturiCumparareReceptieNouaView.vb</DependentUpon>
    </Compile>
    <EmbeddedResource Update="Views\FacturiCumparare\FacturiCumparareReceptieNouaView.resx">
      <DependentUpon>FacturiCumparareReceptieNouaView.vb</DependentUpon>
    </EmbeddedResource>
    <Compile Update="Views\FacturiCumparare\FacturiCumparareReceptiiExistenteView.vb">
      <SubType>UserControl</SubType>
    </Compile>
    <Compile Update="Views\FacturiCumparare\FacturiCumparareReceptiiExistenteView.Designer.vb">
      <DependentUpon>FacturiCumparareReceptiiExistenteView.vb</DependentUpon>
    </Compile>
    <EmbeddedResource Update="Views\FacturiCumparare\FacturiCumparareReceptiiExistenteView.resx">
      <DependentUpon>FacturiCumparareReceptiiExistenteView.vb</DependentUpon>
    </EmbeddedResource>
    <Compile Update="Views\FacturiCumparare\FacturiCumparareReceptiiAsociateView.vb">
      <SubType>UserControl</SubType>
    </Compile>
    <Compile Update="Views\FacturiCumparare\FacturiCumparareReceptiiAsociateView.Designer.vb">
      <DependentUpon>FacturiCumparareReceptiiAsociateView.vb</DependentUpon>
    </Compile>
    <EmbeddedResource Update="Views\FacturiCumparare\FacturiCumparareReceptiiAsociateView.resx">
      <DependentUpon>FacturiCumparareReceptiiAsociateView.vb</DependentUpon>
    </EmbeddedResource>
  </ItemGroup>

  <!-- Slice KE21: the view of the reception and the table of angajamente, one folder, the code split by responsibility (the partial files hang under the view's file). -->
  <ItemGroup>
    <Compile Update="Views\Receptii\KeReceptiiView.vb;Views\Receptii\KeAngajamenteView.vb">
      <SubType>UserControl</SubType>
    </Compile>
    <Compile Update="Views\Receptii\KeReceptiiView.Designer.vb;Views\Receptii\KeReceptiiView.Amounts.vb;Views\Receptii\KeReceptiiView.Angajamente.vb;Views\Receptii\KeReceptiiView.Commit.vb;Views\Receptii\KeReceptiiView.Invoices.vb;Views\Receptii\KeReceptiiView.Lines.vb;Views\Receptii\KeReceptiiView.Receptii.vb;Views\Receptii\KeReceptiiView.Ribbon.vb;Views\Receptii\KeReceptiiView.Viewing.vb">
      <DependentUpon>KeReceptiiView.vb</DependentUpon>
    </Compile>
    <EmbeddedResource Update="Views\Receptii\KeReceptiiView.resx">
      <DependentUpon>KeReceptiiView.vb</DependentUpon>
    </EmbeddedResource>
    <Compile Update="Views\Receptii\KeAngajamenteView.Designer.vb;Views\Receptii\KeAngajamenteView.Fill.vb;Views\Receptii\KeAngajamenteView.Grid.vb;Views\Receptii\KeAngajamenteView.Link.vb;Views\Receptii\KeAngajamenteView.Load.vb">
      <DependentUpon>KeAngajamenteView.vb</DependentUpon>
    </Compile>
  </ItemGroup>
  <!-- Safety net: a .resx with two dots (Class.Part.resx) is never a real resource here; Visual Studio creates one when a partial file is double-clicked, and it would clash with Class.resx (MSB3577). -->
  <ItemGroup>
    <EmbeddedResource Remove="**\*.*.resx" />
  </ItemGroup>
  <!-- Partial files are plain code: SubType Code stops Visual Studio opening the designer on them (a double-click there creates a stray .resx, and two .resx for one class break the build with MSB3577). -->
  <ItemGroup>
    <Compile Update="Forms\FacturiVanzareForm.Arbore.vb">
      <DependentUpon>Forms\FacturiVanzareForm.vb</DependentUpon>
    </Compile>
    <Compile Update="FacturiForm.Arbore.vb;FacturiForm.Client.vb;FacturiForm.Furnizor.vb;FacturiForm.Linii.vb;FacturiForm.Pagini.vb;FacturiForm.Pdf.vb;FacturiForm.Trimitere.vb;Forms\VerconForm.Tutorial.vb">
      <SubType>Code</SubType>
    </Compile>
    <Compile Update="Forms\FacturiVanzareForm.Trimitere.vb">
      <DependentUpon>Forms\FacturiVanzareForm.vb</DependentUpon>
    </Compile>
    <Compile Update="Forms\FacturiVanzareForm.Pdf.vb">
      <DependentUpon>Forms\FacturiVanzareForm.vb</DependentUpon>
    </Compile>
    <Compile Update="Forms\FacturiVanzareForm.Pagini.vb">
      <DependentUpon>Forms\FacturiVanzareForm.vb</DependentUpon>
    </Compile>
    <Compile Update="Forms\FacturiVanzareForm.Linii.vb">
      <DependentUpon>Forms\FacturiVanzareForm.vb</DependentUpon>
    </Compile>
    <Compile Update="Forms\FacturiVanzareForm.Furnizor.vb">
      <DependentUpon>Forms\FacturiVanzareForm.vb</DependentUpon>
    </Compile>
    <Compile Update="Forms\FacturiVanzareForm.Client.vb">
      <DependentUpon>Forms\FacturiVanzareForm.vb</DependentUpon>
    </Compile>
    <Compile Update="Views\FacturiCumparare\FacturiCumparareView.Access.vb;Views\FacturiCumparare\FacturiCumparareView.Contare.vb;Views\FacturiCumparare\FacturiCumparareView.Lista.vb;Views\FacturiCumparare\FacturiCumparareView.RecepArbore.vb;Views\FacturiCumparare\FacturiCumparareView.Receptii.vb">
      <DependentUpon>Views\FacturiCumparare\FacturiCumparareView.vb</DependentUpon>
      <SubType>Code</SubType>
    </Compile>
    <Compile Update="Views\Receptii\KeReceptiiView.Amounts.vb;Views\Receptii\KeReceptiiView.Angajamente.vb;Views\Receptii\KeReceptiiView.Commit.vb;Views\Receptii\KeReceptiiView.Invoices.vb;Views\Receptii\KeReceptiiView.Lines.vb;Views\Receptii\KeReceptiiView.Receptii.vb;Views\Receptii\KeReceptiiView.Ribbon.vb;Views\Receptii\KeReceptiiView.Viewing.vb;Views\Receptii\KeAngajamenteView.Fill.vb;Views\Receptii\KeAngajamenteView.Grid.vb;Views\Receptii\KeAngajamenteView.Link.vb;Views\Receptii\KeAngajamenteView.Load.vb">
      <SubType>Code</SubType>
    </Compile>
  </ItemGroup>
</Project>
