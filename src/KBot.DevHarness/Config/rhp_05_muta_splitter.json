{
  // ── TEST 5 — «Se poate MUTA panoul, în loc să-l ascundem sau să decupăm?» ──
  //
  // `normal.xml` arată că AVSplitationPageView este WS_CHILD, în ACELAȘI proces,
  // deja enumerat de probă. Deci banda neagră din stânga e o regiune de fereastră
  // copil obișnuită: se poate MUTA, nu doar ascunde. Asta e opusul cazului
  // AVL_AVPopup și cere mecanismul opus.
  //
  // DE CE E MAI BUN DECÂT DECUPAREA (acolo unde merge): decuparea MĂREȘTE
  // fereastra găzduită, deci un zoom «fit width» / «fit page» rescalează pagina
  // la lățimea umflată și decuparea începe să mănânce din document. Mutarea unui
  // copil nu schimbă deloc dimensiunea gazdei, deci pagina își păstrează scara.
  //
  // ATENȚIE LA ȚINTĂ (din proba de la 14:09, în coordonate client-gazdă):
  //   AV2DocumentTabView      x=11   y=63    1556x1278
  //     AVSplitationPageView  x=11   y=153   1466x1188
  //       AVSplitterView      x=131  y=153   1346x1188
  // Banda neagră de ~120px e ÎN INTERIORUL lui AVSplitationPageView, la stânga
  // lui AVSplitterView. Dacă muți AVSplitationPageView, banda călătorește cu el
  // și nu dispare. Fereastra care trebuie mutată este AVSplitterView.
  // La fel pe verticală: banda de bare de la y=63 la y=153 e în AV2DocumentTabView,
  // deasupra lui AVSplitterView.
  //
  // IPOTEZĂ DE CONFIRMAT VIZUAL (nu e un fapt stabilit): o singură operație
  //   dx = -120  dy = -90  dw = +120  dh = +90
  // ar înlocui ȘI decuparea din stânga, ȘI pe cea de sus.
  //
  // CE URMĂREȘTI:
  //   1. Log-ul: «MUTAT: «AVSplitterView» 131,153 1346x1188 -> 11,63 1466x1278»?
  //      Dacă scrie NESCHIMBAT, Adobe a refuzat mutarea sau a pus-o înapoi
  //      instantaneu — ambele sunt rezultate, notează-le.
  //   2. Ecranul: a dispărut banda neagră din stânga? A urcat documentul peste
  //      banda de bare?
  //   3. Contorul de reaplicare din bara de stare («reaplicare 3/40»): dacă
  //      Adobe pune fereastra înapoi la aproape fiecare tick, metoda pâlpâie în
  //      producție și decuparea rămâne varianta onestă. Dacă e ocazional
  //      (resize / schimbare de zoom / schimbare de document), mutarea câștigă.
  "schema": 1,
  "requireCleanBaseline": true,
  "name": "RHP 05: mută AVSplitterView (fără decupare)",
  "note": "Mută splitter-ul în sus-stânga peste jgheab și peste banda de bare. Nicio decupare, nicio ascundere — doar mutare.",

  "launch": {
    "newInstance": true,
    "noSplash": true
  },

  "openParameters": {
    "toolbar": 0,
    "navpanes": 0,
    "statusbar": 0,
    "messages": 0,
    "scrollbar": 0,
    "pagemode": "none"
  },

  // Decuparea rămâne EXPLICIT oprită: dacă ar fi activă nu s-ar mai putea spune
  // care dintre cele două mecanisme a produs ce se vede pe ecran.
  "clip": {
    "enabled": false
  },

  "moveChildren": [
    {
      "byText": "AVSplitterView",
      "dx": -120,
      "dy": -90,
      "dw": 120,
      "dh": 90
    }
  ],

  "moveOptions": {
    // Adobe reface aranjarea la resize, zoom, schimbare de document și diverse
    // repictări. Fără reaplicare, mutarea ține până la prima astfel de acțiune.
    "reapply": true,
    "reapplyIntervalMs": 500
  },

  "scenario": [
    "launch",
    "waitForEmbed",
    "probe",
    "moveChildren"
  ]
}
