    Private Sub OnTabSelected(tabKey As String) Handles chart.TabSelected
        Try
            Note($"grafic → «{tabKey}», reconstruit în {Rebuild(lanes:=False, chart:=True)} ms")
        Catch ex As Exception
            GlobalErrorLog.Write("AsociereStressForm.OnTabSelected", ex)
        End Try
    End Sub

    ''' <summary>A point stands for a snapshot; clicking one selects its receipt, as in the form.</summary>
    Private Sub OnPointClicked(seriesKey As String, pointIndex As Integer) Handles chart.PointClicked
        Try
            If String.Equals(seriesKey, TOTAL_KEY, StringComparison.Ordinal) Then Return
            Dim series As KBotChartSeries = Me.chart.FindSeries(seriesKey)
            If series Is Nothing OrElse pointIndex < 0 OrElse pointIndex >= series.Points.Count Then Return
            Dim inst As InstantaneuLegat = TryCast(series.Points(pointIndex).Tag, InstantaneuLegat)
            If inst Is Nothing Then Return
            Note($"punct: instantaneul {inst.Idrh} · {Money(inst.Total)}")
        Catch ex As Exception
            GlobalErrorLog.Write("AsociereStressForm.OnPointClicked", ex)
        End Try
    End Sub

    ''' <summary>A frozen snapshot cannot be dragged at all — the padlock is not decoration.</summary>
    Private Sub OnDragStarting(sender As Object, e As LaneDragStartEventArgs) Handles lanes.MarkerDragStarting
        Try
            Dim inst As InstantaneuLegat = TryCast(e.Marker?.Tag, InstantaneuLegat)
            If inst Is Nothing OrElse inst.Blocat Then
                e.Cancel = True
                If inst IsNot Nothing Then Note($"instantaneul {inst.Idrh} e blocat, nu se trage")
            End If
        Catch ex As Exception
            GlobalErrorLog.Write("AsociereStressForm.OnDragStarting", ex)
            e.Cancel = True
        End Try
    End Sub

    ''' <summary>Refusal is the default; this says yes to anything that actually moves.</summary>
    Private Sub OnMarkerDragOver(sender As Object, e As LaneDragOverEventArgs) Handles lanes.MarkerDragOver
        Try
            Dim inst As InstantaneuLegat = TryCast(e.Marker?.Tag, InstantaneuLegat)
            If inst Is Nothing OrElse e.Target Is Nothing Then Return
            If inst.Blocat Then
                e.Reason = "Instantaneul e blocat de o ordonanțare."
                Return
            End If
            If e.From IsNot Nothing AndAlso String.Equals(e.From.Key, e.Target.Key, StringComparison.Ordinal) Then
                e.Reason = "E deja pe banda asta."
                Return
            End If
            e.Allow = True
        Catch ex As Exception
            GlobalErrorLog.Write("AsociereStressForm.OnMarkerDragOver", ex)
        End Try
    End Sub

    ''' <summary>
    ''' The move itself: the control never moves a marker, it only says a drop happened. This is
    ''' also the path that lags in the real form, so the rebuild it triggers is timed.
    ''' </summary>
    Private Sub OnDropped(sender As Object, e As LaneDropEventArgs) Handles lanes.MarkerDropped
        Try
            Dim inst As InstantaneuLegat = TryCast(e.Marker?.Tag, InstantaneuLegat)
            If inst Is Nothing OrElse e.Target Is Nothing Then Return

            Dim target As Integer = 0
            If Not String.Equals(e.Target.Key, LOOSE_KEY, StringComparison.Ordinal) Then
                Dim rec As ReceptiePropusa = TryCast(e.Target.Tag, ReceptiePropusa)
                If rec Is Nothing Then Return
                target = rec.Idrr
            End If

            _placement(inst.Idrh) = target
            Dim laneMs As Long = Rebuild(lanes:=True, chart:=False)
            Dim chartMs As Long = Rebuild(lanes:=False, chart:=True)
            Note($"mutat {inst.Idrh} → {If(target = 0, "neașezate", "R" & target.ToString(CultureInfo.InvariantCulture))} " &
                 $"· benzi {laneMs} ms · grafic {chartMs} ms")
        Catch ex As Exception
            GlobalErrorLog.Write("AsociereStressForm.OnDropped", ex)
            Note("EROARE la mutare: " & ex.Message)
        End Try
    End Sub

