    Private Sub OnClassic(sender As Object, e As EventArgs) Handles btnClassic.Click
        SwitchScheme(BuiltInSchemes.Classic())
    End Sub

    Private Sub OnDark(sender As Object, e As EventArgs) Handles btnDark.Click
        SwitchScheme(BuiltInSchemes.Dark())
    End Sub

    Private Sub OnModern(sender As Object, e As EventArgs) Handles btnModern.Click
        SwitchScheme(BuiltInSchemes.Modern())
    End Sub

    ''' <summary>
    ''' The scheme decides the marker colours and the total line, so both surfaces are rebuilt
    ''' after it changes — repainting alone would leave yesterday's greens on today's palette.
    ''' </summary>
    Private Sub SwitchScheme(scheme As ThemeScheme)
        Try
            ThemeManager.SetScheme(scheme)
            Rebuild(lanes:=True, chart:=True)
            Note("schema → " & scheme.Name)
        Catch ex As Exception
            GlobalErrorLog.Write("AsociereStressForm.SwitchScheme", ex)
        End Try
    End Sub

    Private Sub Note(text As String)
        Try
            _log?.Invoke(text)
            lstLog.Items.Insert(0, DateTime.Now.ToString("HH:mm:ss", CultureInfo.InvariantCulture) & "  " & text)
        Catch ex As Exception
            GlobalErrorLog.Write("AsociereStressForm.Note", ex)
        End Try
    End Sub

End Class
