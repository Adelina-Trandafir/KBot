<?xml version="1.0" encoding="utf-8"?>
<Workflow name="Recepții {{COD_ANGAJAMENT}}" startUrl="current"
  expectedUrl="https://forexe.mfinante.gov.ro/CABWeb/home">
  <!-- V.1 - 10/09/2026 — felia 0060
    Flux PARȚIAL — numai recepțiile unui angajament
    ───────────────────────────────────────────────
    SEC. 0 — Citire date angajament (din .well)
    SEC. 2 — Recepții (tab1) cu detaliu per recepție

    E o TĂIETURĂ din «adlop - Prelucrare Completa.wfl», nu un drum nou prin site: aceleași
    selectoare, aceiași pași, aceleași nume de tabele. Lipsesc secțiunile 1 (indicatori) și
    4 (istoric), fiindcă butonul din subsolul arborelui de RECEPȚII cere recepțiile, iar
    celelalte două secțiuni sunt exact partea care costă timp fără să răspundă la întrebare.
    Când unul dintre fișiere se schimbă într-o secțiune comună, se schimbă și celălalt —
    decizia D11.

    Serverul primește un pachet FĂRĂ «TabelIndicatori» și FĂRĂ «TabelIstoric»: le citește cu
    `tabele.get(...) or []`, deci pașii lor nu scriu nimic, iar pasul 4b are nevoie de
    indicatori din BAZĂ (`read_indicatori`), nu din sarcina utilă. Verificat citind
    routes/forexe/prelucrare.py.

    Variabile așteptate:
      {{COD_ANGAJAMENT}}   — codul angajamentului de procesat
      {{RECEPTII_SARITE}}  — datele recepțiilor nebifate (zz/ll/aaaa, separate prin virgulă);
                             GOL = se descarcă toate
  -->

  <!-- ═══════════════════════════════════════════════════════
       RESET INTERFAȚĂ — OBLIGATORIU LA ÎNCEPUT
       ═══════════════════════════════════════════════════════ -->

  <IfExists selector="#select2-drop-mask" timeout="1">
    <Click selector="#select2-drop-mask" force="true"
      LogValue="Resetare interfață — închid dropdown-uri deschise" />
  </IfExists>
  <Click selector="#statlogo" waitNavigation="true" timeout="15" />

  <!-- ═══════════════════════════════════════════════════════
       CĂUTARE ANGAJAMENT + DESCHIDERE MODIFICARE
       ═══════════════════════════════════════════════════════ -->

  <Log message="══ Caut și deschid angajamentul {{COD_ANGAJAMENT}} ══" level="action" />

  <Click selector="a:has-text('Listă angajamente')" waitNavigation="false" timeout="15" />
  <Fill selector="input[name='cod']" value="{{COD_ANGAJAMENT}}" clear="true" timeout="15" />
  <Click selector="button:has-text('Caută')" waitNavigation="false" timeout="15" />

  <IfExists selector=".alert.alert-warning:has-text('Căutarea nu a întors niciun rezultat!')"
    timeout="1">
    <Log message="EROARE: Angajamentul {{COD_ANGAJAMENT}} nu există în listă!" level="error" />
    <Exit message="Angajamentul {{COD_ANGAJAMENT}} nu a fost găsit. Opresc execuția." />
  </IfExists>

  <WaitFor selector="a[href*='exportToXLS']" timeout="15" />
  <Click selector="a.haction i.glyphicon-list:visible" timeout="15" />
  <WaitFor selector=".divaction" state="visible" timeout="15" />
  <Click selector=".divaction a:has-text('Modificare')" waitNavigation="true" timeout="15" />
  <WaitFor selector="li.tab0" timeout="15" />

  <Log message="Angajament {{COD_ANGAJAMENT}} deschis în modul Modificare." level="success" />

  <!-- ═══════════════════════════════════════════════════════
       SECȚIUNEA 0 — CITIRE DATE ANGAJAMENT (din .well)
       ═══════════════════════════════════════════════════════ -->

  <Log message="══ SECȚIUNEA 0: Citesc datele angajamentului ══" level="action" />

  <Read selector=".well.well-small h4 span:nth-child(2)" saveTo="CodAngajament" />
  <Read
    selector=".well.well-small div.clearfix:has(strong:has-text('Dată angajament')) span:last-child"
    saveTo="DataAngajament" />
  <IfExists
    selector=".well.well-small div.clearfix:has(strong:has-text('Dată început')) span:last-child">
    <Read
      selector=".well.well-small div.clearfix:has(strong:has-text('Dată început')) span:last-child"
      saveTo="DataInceputDerulare" />
  </IfExists>

  <IfExists
    selector=".well.well-small div.clearfix:has(strong:has-text('Ultima modificare')) span:last-child">
    <Read
      selector=".well.well-small div.clearfix:has(strong:has-text('Ultima modificare')) span:last-child"
      saveTo="UltimaModificare" />
  </IfExists>

  <Read selector=".well.well-small div.pull-left p" saveTo="DescriereAngajament" />
  <Read selector=".well.well-small span.label" saveTo="StareAngajament" />

  <Log message="✓ Date angajament citite: [[CodAngajament]] / [[StareAngajament]]" level="success" />

  <!-- ═══════════════════════════════════════════════════════
       SECȚIUNEA 2 — RECEPȚII (tab1)
       Guard nivel 1: tab-ul există în DOM.
       Guard nivel 2: tabelul are cel puțin un rând.
       Selector exterior: table.table-striped.table-bordered.table-condensed
       Selector interior: table.table-striped.table-bordered.table-hover.table-condensed
       ═══════════════════════════════════════════════════════ -->

  <Log message="══ SECȚIUNEA 2: Recepții ══" level="action" />

  <IfExists selector="li.tab1" timeout="15">

    <Click selector="li.tab1 a" timeout="15" />
    <WaitFor selector="li.tab1.active" state="visible" timeout="15" />

    <!-- Guard nivel 2: tab activ dar posibil gol -->
    <IfExists selector="table.table-striped.table-bordered.table-condensed tbody tr" timeout="15">

      <ScrapeTable selector="table.table-striped.table-bordered.table-condensed"
        saveTo="ListaReceptii"
        timeout="15" />

      <Log message="Lista recepții citită. Încep iterarea..." level="info" />

      <ForEachVar source="ListaReceptii" itemPrefix="R" indexVariable="idx"
        collectFields="Tip,Data,Suma,TipReceptie,DescriereReceptie,CodIndicator,Detaliu">

      <!-- NOTA (26.08.2026): «TipReceptie» ramane in collectFields fiindca D11 cere ca
           cele doua fisiere de workflow sa se potriveasca, si o coloana necitita in plus
           nu costa nimic. NIMIC nu o consuma insa pe server: hash-ul de identitate al
           antetului se face din «Tip», iar FX_Receptii_R.TipReceptie e calculat
           (NOU/EDIT). Cerinta unui 400 la lipsa ei e RETRASA. Vezi corectia C5 din
           docs/FUNDAMENT_Asociere_Receptii.md.
           «Detaliu», in schimb, E citit, si soseste ca LISTA imbricata: un ScrapeTable
           interior il scrie cu saveTo, iar decizia D-N spune ca structura calatoreste
           pana la server neaplatizata. -->

        <!-- ═══ SELECȚIA OPERATORULUI (felia 0060) ═══════════════════════════
             {{RECEPTII_SARITE}} = datele recepțiilor pe care operatorul NU le-a bifat în
             macheta de reîmprospătare, zz/ll/aaaa, separate prin virgulă. GOL = nu se sare
             peste niciuna, adică exact comportamentul dinainte de felia asta.

             Se sare peste DETALIUL recepției, nu peste rândul ei: rândul rămâne în
             «ListaReceptii» fiindcă ScrapeTable l-a citit deja, iar clientul îl scoate
             înainte de trimitere (WorkflowResultStore.FaraReceptiileSarite). Aici se
             economisesc chiar minutele: o deschidere de pagină pe recepție.

             Cele patru variabile scrise în iterație se GOLESC pe ramura asta. Obligatoriu,
             nu igienă: BuildCollectedRow citește un câmp lipsă din variabila cu același
             nume, iar SetVariable adaugă într-o listă din care se ia ULTIMA valoare — deci
             fără golire, recepția sărită ar pleca spre server cu «Detaliu»-ul VECINEI ei.
             "[]" pentru Detaliu, nu "": serverul cere o listă acolo (cere_lista), iar un
             șir gol e refuzat. -->
        <IfVar value="{{RECEPTII_SARITE}}" compare="regex:(^|,)[[R.Data]](,|$)">

          <Log message="Recepția [[idx]] ([[R.Data]]) nu a fost bifată — sar peste detaliul ei."
            level="info" />
          <SetInternalVar name="Detaliu" value="[]" />
          <SetInternalVar name="TipReceptie" value="" />
          <SetInternalVar name="DescriereReceptie" value="" />
          <SetInternalVar name="CodIndicator" value="" />

          <Else>
          <Log message="Procesez recepția [[idx]]: [[R.Tip]] / [[R.Data]] / [[R.Suma]]..."
            level="info" />

          <!-- nth-child e 1-based, exact ca idx -->
          <Click
            selector="table.table-striped.table-bordered.table-condensed tbody tr:nth-child([[idx]]) .glyphicon-eye-open"
            waitNavigation="false" timeout="15" />

          <WaitFor selector="h3.heading:has-text('Modifică recepție')" timeout="15" />
          <WaitFor selector="select[name='receptie']" timeout="15" />

          <Read selector="select[name='receptie']" saveTo="TipReceptie" />
          <Read selector="textarea[name='descriere']" saveTo="DescriereReceptie" />

          <!-- Tabelul interior: selector cu table-hover — diferențiator față de tabelul exterior -->
          <ScrapeTable selector="table.table-striped.table-bordered.table-hover.table-condensed"
            saveTo="Detaliu"
            nextPageSelector="a[rel='next']"
            waitSelector="table.table-striped.table-bordered.table-hover.table-condensed"
            fingerprintSelector="table.table-striped.table-bordered.table-hover.table-condensed tbody tr:last-child td:last-child"
            timeout="15" />

          <!-- Cod din primul rând al tabelului interior -->
          <Read
            selector="table.table-striped.table-bordered.table-hover.table-condensed tbody tr:first-child td:nth-child(1) span"
            saveTo="CodIndicator" />

          <Log message="✓ Recepția [[idx]] procesată. Revin la listă..." level="success" />

          <!-- GoBack via browser — butonul 'Înapoi' din UI afișează confirmare modală -->
          <GoBack />
          <WaitFor selector="li.tab1.active" state="visible" timeout="15" />
          </Else>
        </IfVar>

      </ForEachVar>

      <Log message="✓ Secțiunea Recepții finalizată." level="success" />

      <Else>
        <Log message="Tab Recepții există dar nu conține înregistrări pentru {{COD_ANGAJAMENT}}."
          level="warning" />
      </Else>
    </IfExists>

    <Else>
      <Log message="Tab-ul Recepții (tab1) nu este disponibil pentru {{COD_ANGAJAMENT}}."
        level="warning" />
    </Else>
  </IfExists>

  <!-- ═══════════════════════════════════════════════════════
       FINAL
       ═══════════════════════════════════════════════════════ -->

  <Log message="══ Recepțiile angajamentului {{COD_ANGAJAMENT}} au fost citite. ══"
    level="success" />

</Workflow>
