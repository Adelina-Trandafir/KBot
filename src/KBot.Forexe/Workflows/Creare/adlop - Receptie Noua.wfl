<?xml version="1.0" encoding="utf-8"?>
<!-- V1.0 - 16.10.2026: K-BOT slice KE05 (plan docs/KE_PLAN.md).
     ADDS ONE NEW RECEPTION to an angajament, for a received e-invoice. It is the reception part of «Rezervare si Receptie»
     (steps «tab Receptii > Adauga > tip, data, descriere, valoare pe indicator > Salveaza»), cut out WITHOUT the reservation
     steps, with the angajament opened by its code like «Incarca Rezervare», and with a check that the site said «saved».

     Variables from K-BOT (all always sent):
       {{COD_ANGAJAMENT}}      - the angajament code
       {{TIP_RECEPTIE}}        - the text of the type in the site's list: Avans / Partial / Final
       {{DATA_RECEPTIE}}       - the date typed into the form: zz.ll.aaaa
       {{DESCRIERE_RECEPTIE}}  - the description, ENDING with the K-BOT marker «(IDRH: n; IDR: m)» K-BOT reserved
       DATE_RECEPTIE           - JSON array, one object per indicator row:
         [ { "ClsfSal": "650302100101", "Clsf": "65.03.02.10.01.01", "CodIndicator": "AAB", "Valoare": "1.380,00" } ]
         ClsfSal = the classification without dots, matched like «Incarca Rezervare» matches it (the «01A- » prefix off, letters
         and digits only, «includes»); Valoare = the whole value of the field, in the site's spelling (1.380,00).

     What it leaves for K-BOT (variables read at the end):
       MesajSalvare - the text of the site's success element (.alert.alert-success), EMPTY when the element did not show up
                      in time. K-BOT then re-reads the list of receptions to see whether the reception was saved anyway.
       MesajEroare  - the text of the site's error element (.alert.alert-error strong, e.g. «CAB-0031 - Datele introduse nu sunt valide...»),
                      EMPTY when the site showed none. When it is filled the reception was NOT saved: K-BOT shows it and stops.
     {{DATA_RECEPTIE}} is typed as zz.ll.aaaa and the values of DATE_RECEPTIE use «,» as the decimal separator, whatever Windows says.
     The save click is marked commits="true": in a dry run the robot stops right before it. -->
<Workflow name="Receptie noua pentru {{COD_ANGAJAMENT}}" startUrl="current" expectedUrl="forexe.mfinante.gov.ro">

  <Log message="Adaug o recepție nouă pe {{COD_ANGAJAMENT}}..." level="success" />

  <!-- OBLIGATORIU LA INCEPUT -->
  <IfExists selector="#select2-drop-mask" timeout="1">
    <Click selector="#select2-drop-mask" force="true" LogValue="Resetare interfata" />
  </IfExists>
  <Click selector="#statlogo" waitNavigation="true" timeout="10" />

  <!-- CAUTARE ANGAJAMENT + DESCHIDERE MODIFICARE -->
  <Click selector="a:has-text('Listă angajamente')" waitNavigation="false" timeout="5" LogValue="Click Listă angajamente" />
  <Fill selector="input[name='cod']" value="{{COD_ANGAJAMENT}}" clear="true" timeout="5" LogValue="Caut angajamentul {{COD_ANGAJAMENT}}" />
  <Click selector="button:has-text('Caută')" waitNavigation="false" timeout="5" LogValue="Click Caută" />

  <IfExists selector=".alert.alert-warning:has-text('Căutarea nu a întors niciun rezultat!')" timeout="1">
    <Log message="EROARE: Angajamentul {{COD_ANGAJAMENT}} nu există în listă!" level="error" />
    <Exit message="Angajamentul {{COD_ANGAJAMENT}} nu a fost găsit. Opresc execuţia." />
  </IfExists>

  <WaitFor selector="a[href*='exportToXLS']" timeout="5" LogValue="Aştept lista de rezultate" />
  <Click selector="a.haction i.glyphicon-list:visible" timeout="10" LogValue="Click iconiţa detalii angajament" />
  <WaitFor selector=".divaction" state="visible" timeout="10" />
  <Click selector=".divaction a:has-text('Modificare')" waitNavigation="true" timeout="5" LogValue="Click Modificare" />
  <WaitFor selector="li.tab0" timeout="5" LogValue="Aştept formularul de modificare" />

  <!-- DATE DIN K-BOT -->
  <SetInternalVar name="DATE_RECEPTIE" value="{{!DATE_RECEPTIE|Array randuri de pe receptie|type=JSON}}" />

  <!-- TAB RECEPTII > ADAUGA -->
  <Click selector="ul.nav.nav-tabs > li.tab1" waitNavigation="false" timeout="5" LogValue="Apas pe tab Receptii" />
  <WaitFor selector="li.tab1.active" state="visible" timeout="10" />
  <Click selector="button:has-text('Adaugă')" waitNavigation="true" timeout="5" LogValue="Apas «Adaugă»" />
  <WaitFor selector="form.form-horizontal" state="visible" timeout="10" />

  <Select selector="form.form-horizontal select[name='receptie']" text="{{TIP_RECEPTIE}}" timeout="5"
          LogValue="Selectez tipul recepției {{TIP_RECEPTIE}}" />
  <Fill selector="form.form-horizontal input[name='data']" value="{{DATA_RECEPTIE}}" clear="true" timeout="5"
        LogValue="Completez data recepției" />
  <Fill selector="form.form-horizontal textarea[name='descriere']" value="{{DESCRIERE_RECEPTIE}}" clear="true" timeout="5"
        LogValue="Completez descrierea recepției" />

  <!-- VALOAREA PE FIECARE INDICATOR -->
  <ForEachVar source="DATE_RECEPTIE" itemPrefix="R" indexVariable="idx">
    <Log message="Rândul [[idx]]: [[R.Clsf]] = [[R.Valoare]]" level="info" />
    <FindInTable
      selector="table.table-striped"
      fieldName="Sector - Sursa - Indicator"
      value="[[R.ClsfSal]]"
      fieldTransform="regex:/^[0-9]{2}[A-Z]-\s*/g:|stripNonAlphaNum"
      timeout="30">
      <Fill selector="input[name*='valoare']" value="[[R.Valoare]]" clear="true" />
    </FindInTable>
  </ForEachVar>

  <Screenshot saveTo="Poza_Receptie" LogValue="Captură ecran — recepția completată" />

  <!-- SALVARE + SEMNUL CA S-A SALVAT -->
  <Click selector="button:has-text('Salvează')" commits="true" waitNavigation="true" timeout="5" isCheckpoint="true"
         LogValue="Apas Salvează" />

  <SetInternalVar name="MesajSalvare" value="" />
  <SetInternalVar name="MesajEroare" value="" />
  <!-- Either element ends the wait: the site answers with the green success box or with the red error box
       (e.g. «CAB-0031 - Datele introduse nu sunt valide»). The error is looked at FIRST: a page that shows it was not saved. -->
  <IfExists selector=".alert.alert-success, .alert.alert-error" timeout="8">
    <IfExists selector=".alert.alert-error" timeout="1">
      <Read selector=".alert.alert-error strong" saveTo="MesajEroare" />
    </IfExists>
    <IfExists selector=".alert.alert-success" timeout="1">
      <Read selector=".alert.alert-success" saveTo="MesajSalvare" />
    </IfExists>
  </IfExists>

</Workflow>
