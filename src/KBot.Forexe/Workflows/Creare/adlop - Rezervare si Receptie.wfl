<?xml version="1.0" encoding="utf-8"?>
<Workflow name="Rezervare suma pentru {{COD_ANGAJAMENT}}" startUrl="current"
  expectedUrl="https://forexe.mfinante.gov.ro/CABWeb/home">
  <!-- V.5
    1. Cauta un Angajament dupa COD.
    2. Apasa Modificare
    3. Apasa pe tab-receptii
    4. Repetă pentru fiecare rând din tabelul 'An curent'
    4.1. Apasa pe 'ochi'
    4.2. Citește 'CodAngajament', 'Tip', 'Data', 'Descriere'
    4.3. Descarca lista cu recepțiile detaliate (xls)
  -->
  <!-- OBLIGATORIU LA INCEPUT !-->
  <IfExists selector="#select2-drop-mask">
    <Click selector="#select2-drop-mask" force="true" waitNavigation="true" timeOut="5"
      LogValue="Resetare interfață (închid ferestre)" />
  </IfExists>
  <Click selector="#statlogo" waitNavigation="true" timeout="10" />
  <!-- PANA AICI -->

  <Click selector="a:has-text('Listă angajamente')" waitNavigation="false" timeout="5"
    LogValue="Apas pe 'Listă angajamente'" /> <!--MAI
  APAS O DATA PE ELEMENT SA MA ASIGUR. DACA TRECE PREA MULT TIMP, CHIAR DACA NAVIGHEZ LA O PAGINA,
  PRIMA ACTIUNE MA DUCE LA HOME IMPLICIT-->

  <Fill selector="input[name='cod']" value="{{COD_ANGAJAMENT}}" clear="true" timeout="5"
    LogValue="Caut angajamentul {{COD_ANGAJAMENT}}" />
  <Click selector="button:has-text('Caută')" waitNavigation="false" timeout="5" />

  <IfExists selector=".alert.alert-warning:has-text('Căutarea nu a întors niciun rezultat!')"
    timeOut="1">
    <Exit LogValue="Nu există codul căutat! Se iese." />
  </IfExists>

  <WaitFor selector="a[href*='exportToXLS']" timeout="5" />

  <Click selector="a.haction i.glyphicon-list:visible" timeout="10" />
  <WaitFor selector=".divaction" state="visible" timeout="10" />

  <Click selector=".divaction a:has-text('Modificare')" waitNavigation="true" timeout="5"
    LogValue="Apăs pe Modificare." />

  <WaitFor selector="ul.nav.nav-tabs > li.tab0.active" timeout="5" />
  
  <SetInternalVar name="DATE_BUGET" value="{{!DATE_BUGET|Array randuri|type=JSON}}" />

  <ForEachVar source="DATE_BUGET" itemPrefix="RAND" indexVariable="idx">
    <Log message="Procesez rândul [[idx]]: [[RAND.cod]]" level="info" />

    <FindInTable
      selector="table.table-striped"
      fieldName="Sector - Sursa - Indicator"
      value="[[RAND.cod]]"
      fieldTransform="trim"
      timeout="30"
      ClickSelector="a.haction i.glyphicon-list:visible">

     <Fill selector="input[name*='valoare']" value="[[RAND.valoare]]" />

     <Screenshot SaveTo="buget_[[RAND.cod]]" IsCheckpoint="true" />

     <Click selector="button:has-text('Salvează')" waitNavigation="false" timeout="5" IsCheckpoint="true"
      LogValue="Salvez modificările" />

     <WaitFor selector="form.form-horizontal" state="visible" timeout="5" />

     <Fill selector="form.form-horizontal textarea[name='modal:form:motiv']"
      value="Rezervare suma pentru {{COD_ANGAJAMENT}}" clear="true" timeout="5"
      LogValue="Completez motivul modificarii" />

     <Click selector="form.form-horizontal button:has-text('Continuă')" waitNavigation="true"
      timeout="5" LogValue="Confirm modificările" isCheckpoint="true" />

     <WaitFor selector=".alert.alert-success:has-text('Rândul angajamentului a fost salvat.')"
      timeOut="5" isCheckpoint="true" />

    </FindInTable>
  </ForEachVar>

  <WaitFor selector="ul.nav.nav-tabs > li.tab0.active" timeout="5" />

  <Click selector="ul.nav.nav-tabs > li.tab1" waitNavigation="false" timeout="5"
    LogValue="Apas pe tab 'Recepții'" />

  <Click selector="button:has-text('Adaugă')" waitNavigation="true" timeout="5" /> <!--
  LogValue="Apas pe 'Adaugă' pentru a adauga o receptie noua" -->
  <WaitFor selector="form.form-horizontal" state="visible" timeout="5" />
  <Select selector="form.form-horizontal select[name='receptie']" text="{{TIP_RECEPTIE}}"
    timeout="5"
    LogValue="Selectez tipul receptiei {{TIP_RECEPTIE}}" />

  <Fill selector="form.form-horizontal input[name='data']" value="{{DATA_RECEPTIE}}" clear="true"
    timeout="5" LogValue="Completez data receptiei" />
  <Fill selector="form.form-horizontal textarea[name='descriere']" value="{{DESCRIERE_RECEPTIE}}"
    timeout="5" LogValue="Completez descrierea receptiei" />

  <SetInternalVar name="DATE_RECEPTIE" value="{{!DATE_RECEPTIE|Array randuri|type=JSON}}" />

  <ForEachVar source="DATE_RECEPTIE" itemPrefix="RAND" indexVariable="idx">
    <Log message="Procesez rândul [[idx]]: [[RAND.cod]]" level="info" />
    <FindInTable
      selector="table.table-striped"
      fieldName="Sector - Sursa - Indicator"
      value="[[RAND.cod]]"
      fieldTransform="trim"
      timeout="30">
     <Fill selector="input[name*='valoare']" value="[[RAND.valoare]]" />
    </FindInTable>
  </ForEachVar>

  <Screenshot saveTo="picReceptii" />

  <Click selector="button:has-text('Salvează')" waitNavigation="true" timeout="2" />

</Workflow>