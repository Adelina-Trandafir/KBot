<?xml version="1.0" encoding="utf-8"?>
<Workflow name="Rezervări {{COD_ANGAJAMENT}}" startUrl="current"
  expectedUrl="https://forexe.mfinante.gov.ro/CABWeb/home">
  <!-- V.1 - 10/09/2026 — felia 0060
    Flux PARȚIAL — numai rezervările unui angajament
    ───────────────────────────────────────────────
    SEC. 0 — Citire date angajament (din .well)
    SEC. 1 — Indicatori (tab0) cu bugetul fiecăruia
    SEC. 4 — Istoric (cu paginare)

    DE CE ISTORICUL. «Rezervare» nu are pagină proprie în FOREXE: FX_Rezervari se scrie de
    pe server DIN FX_Istoric (pașii 3c/3d — `step3cd_populeaza_rezervari`), iar indicatorii
    dau clasificația și unitatea fiecărui rând. Deci reîmprospătarea rezervărilor înseamnă
    exact secțiunile astea două, plus antetul.

    LIPSEȘTE secțiunea 2 (recepțiile) — și aia e chiar economia: o deschidere de pagină pe
    recepție. Serverul citește «ListaReceptii» cu `tabele.get(...) or []`, deci pasul 4b se
    întoarce imediat și nicio recepție nu se atinge.

    ISTORICUL SE CITEȘTE ÎNAINTE, nu în REVERSE. Varianta REVERSE are nevoie de
    DATA_IESIRE, iar o dată lipsă ar face `exitIfCellEquals="Timp:~:^"` să se
    potrivească cu ORICE rând, adică să oprească citirea la primul. Fluxul ăsta se poate
    cere și pe un angajament fără istoric local, deci merge pe varianta care nu are cum să
    mintă. ⚠ Pe un angajament cu istoric lung asta e mai lent decât REVERSE — de rezolvat
    când există o a doua variantă, la fel ca perechea prelucrării complete.

    Variabile așteptate:
      {{COD_ANGAJAMENT}}  — codul angajamentului de procesat
  -->

  <!-- ═══════════════════════════════════════════════════════
       RESET INTERFAȚĂ — OBLIGATORIU LA ÎNCEPUT
       ═══════════════════════════════════════════════════════ -->

  <IfExists selector="#select2-drop-mask" timeout="1">
    <Click selector="#select2-drop-mask" force="true"
      LogValue="Resetare interfață — închid dropdown-uri deschise" />
  </IfExists>
  <Click selector="#statlogo" waitNavigation="true" timeout="15" />

  <!-- ═══════════════════════════════════════════════════════
       CĂUTARE ANGAJAMENT + DESCHIDERE MODIFICARE
       ═══════════════════════════════════════════════════════ -->

  <Log message="══ Caut și deschid angajamentul {{COD_ANGAJAMENT}} ══" level="action" />

  <Click selector="a:has-text('Listă angajamente')" waitNavigation="false" timeout="15" />
  <Fill selector="input[name='cod']" value="{{COD_ANGAJAMENT}}" clear="true" timeout="15" />
  <Click selector="button:has-text('Caută')" waitNavigation="false" timeout="15" />

  <IfExists selector=".alert.alert-warning:has-text('Căutarea nu a întors niciun rezultat!')"
    timeout="1">
    <Log message="EROARE: Angajamentul {{COD_ANGAJAMENT}} nu există în listă!" level="error" />
    <Exit message="Angajamentul {{COD_ANGAJAMENT}} nu a fost găsit. Opresc execuția." />
  </IfExists>

  <WaitFor selector="a[href*='exportToXLS']" timeout="15" />
  <Click selector="a.haction i.glyphicon-list:visible" timeout="15" />
  <WaitFor selector=".divaction" state="visible" timeout="15" />
  <Click selector=".divaction a:has-text('Modificare')" waitNavigation="true" timeout="15" />
  <WaitFor selector="li.tab0" timeout="15" />

  <Log message="Angajament {{COD_ANGAJAMENT}} deschis în modul Modificare." level="success" />

  <!-- ═══════════════════════════════════════════════════════
       SECȚIUNEA 0 — CITIRE DATE ANGAJAMENT (din .well)
       ═══════════════════════════════════════════════════════ -->

  <Log message="══ SECȚIUNEA 0: Citesc datele angajamentului ══" level="action" />

  <Read selector=".well.well-small h4 span:nth-child(2)" saveTo="CodAngajament" />
  <Read
    selector=".well.well-small div.clearfix:has(strong:has-text('Dată angajament')) span:last-child"
    saveTo="DataAngajament" />
  <IfExists
    selector=".well.well-small div.clearfix:has(strong:has-text('Dată început')) span:last-child">
    <Read
      selector=".well.well-small div.clearfix:has(strong:has-text('Dată început')) span:last-child"
      saveTo="DataInceputDerulare" />
  </IfExists>

  <IfExists
    selector=".well.well-small div.clearfix:has(strong:has-text('Ultima modificare')) span:last-child">
    <Read
      selector=".well.well-small div.clearfix:has(strong:has-text('Ultima modificare')) span:last-child"
      saveTo="UltimaModificare" />
  </IfExists>

  <Read selector=".well.well-small div.pull-left p" saveTo="DescriereAngajament" />
  <Read selector=".well.well-small span.label" saveTo="StareAngajament" />

  <Log message="✓ Date angajament citite: [[CodAngajament]] / [[StareAngajament]]" level="success" />

  <!-- ═══════════════════════════════════════════════════════
       SECȚIUNEA 1 — INDICATORI (tab0)
       Guard: dacă tabelul nu există, sărim secțiunea silențios.
       Selector exterior: table.table-striped.table-bordered.table-condensed
       Selector interior: table.table-bordered.table-hover.table-condensed
       ═══════════════════════════════════════════════════════ -->

  <Log message="══ SECȚIUNEA 1: Indicatori ══" level="action" />

  <WaitFor selector="li.tab0.active" timeout="15" />

  <IfExists selector="table.table-striped.table-bordered.table-condensed tbody tr" timeout="15">

    <ScrapeTable selector="table.table-striped.table-bordered.table-condensed"
      saveTo="TabelIndicatori"
      nextPageSelector="a[rel='next']"
      waitSelector="table.table-striped.table-bordered.table-condensed"
      fingerprintSelector="table.table-striped.table-bordered.table-condensed tbody tr:last-child td:last-child"
      isCheckpoint="true"
      timeout="15" />

    <Log message="Lista indicatori citită. Încep iterarea..." level="info" />

    <ForEachVar source="TabelIndicatori" itemPrefix="R" indexVariable="idx"
      collectFields="Indicator_ang,Program,Obiectiv,Proiect,Sector_Sursa_Indicator,Limita_credit_angajament,Total_credit_angajament,Credit_bugetar,Angajament_legal,Credit_bugetar_rezervat_definitiv_an_curent,Credit_bugetar_rezervat_definitiv_ani_urmatori,Col_12,BugetIndicator">

      <Log
        message="Procesez indicatorul [[idx]]: [[R.Indicator_ang]] / [[R.Sector_Sursa_Indicator]]..."
        level="info" />

      <Click
        selector="table.table-striped.table-bordered.table-condensed tbody tr:nth-child([[idx]]) .glyphicon-eye-open"
        waitNavigation="false" timeout="15" />

      <WaitFor selector="table.table-bordered.table-hover.table-condensed" timeout="15" />

      <ScrapeTable selector="table.table-bordered.table-hover.table-condensed"
        saveTo="BugetIndicator"
        nextPageSelector="a[rel='next']"
        waitSelector="table.table-bordered.table-hover.table-condensed"
        fingerprintSelector="table.table-bordered.table-hover.table-condensed tbody tr:last-child td:last-child"
        timeout="15" />

      <Log message="✓ Indicatorul [[idx]] procesat. Revin la listă..." level="success" />

      <GoBack />
      <WaitFor selector="li.tab0.active" state="visible" timeout="15" />

    </ForEachVar>

    <Log message="✓ Secțiunea Indicatori finalizată." level="success" />

    <Else>
      <Log message="Tab0 nu conține indicatori pentru {{COD_ANGAJAMENT}}." level="warning" />
    </Else>
  </IfExists>

  <!-- ═══════════════════════════════════════════════════════
       SECȚIUNEA 4 — ISTORIC
       Butonul Istoric e accesibil doar din tab0 — revenim explicit.
       Guard: dacă tabelul nu există, sărim secțiunea silențios.
       ═══════════════════════════════════════════════════════ -->

  <Log message="══ SECȚIUNEA 4: Istoric angajament ══" level="action" />

  <Click selector="li.tab0 a" timeout="15" />
  <WaitFor selector="li.tab0.active" timeout="15" />

  <Click selector="button.btn-success:has-text('Istoric')" waitNavigation="true" timeout="15" />
  <WaitFor selector="h3.heading:has-text('Istoric angajament')" timeout="15" />

  <IfExists selector="table.table-striped tbody tr" timeout="15">

    <ScrapeTable selector="table.table-striped"
      saveTo="TabelIstoric"
      nextPageSelector="a[rel='next']"
      waitSelector="table.table-striped"
      fingerprintSelector="table.table-striped tbody tr:last-child td:last-child"
      timeout="15" />
    <Log message="✓ Istoric salvat cu succes." level="success" />

    <Else>
      <Log message="Pagina Istoric nu conține înregistrări pentru {{COD_ANGAJAMENT}}."
        level="warning" />
    </Else>
  </IfExists>

  <!-- ═══════════════════════════════════════════════════════
       FINAL
       ═══════════════════════════════════════════════════════ -->

  <Log message="══ Rezervările angajamentului {{COD_ANGAJAMENT}} au fost citite. ══"
    level="success" />

</Workflow>
