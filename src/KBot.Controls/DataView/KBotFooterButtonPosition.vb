Option Strict On

''' <summary>
''' Latura benzii de subsol pe care stă butonul de strângere al <see cref="KBotDataView"/>.
''' Aceleași două valori (și aceeași implicită) ca la subsolul arborelui, ca cele două controale
''' să nu ceară operatorului două vocabulare pentru același buton.
''' </summary>
Public Enum KBotFooterButtonPosition

    ''' <summary>Colțul din dreapta al benzii de subsol (implicit).</summary>
    Right = 0

    ''' <summary>Colțul din stânga al benzii de subsol.</summary>
    Left = 1

End Enum
