    </Compile>
    <Compile Update="Lane\KBotLaneView.Drag.vb">
      <DependentUpon>KBotLaneView.vb</DependentUpon>
    </Compile>
    <Compile Update="Lane\KBotLaneView.Painting.vb">
      <DependentUpon>KBotLaneView.vb</DependentUpon>
    </Compile>
    <Compile Update="Lane\KBotLaneView.Preview.vb">
