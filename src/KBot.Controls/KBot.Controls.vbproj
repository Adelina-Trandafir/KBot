    </Compile>
    <Compile Update="DataView\KBotDataView.FooterCaption.vb">
      <DependentUpon>KBotDataView.vb</DependentUpon>
    </Compile>
    <Compile Update="DataView\KBotDataView.Grouping.Painting.vb">
      <DependentUpon>KBotDataView.vb</DependentUpon>
    </Compile>
    <Compile Update="DataView\KBotDataView.Grouping.vb">
      <DependentUpon>KBotDataView.vb</DependentUpon>
    </Compile>
    <Compile Update="DataView\KBotDataView.HeaderIcons.vb">
      <DependentUpon>KBotDataView.vb</DependentUpon>
    </Compile>
    <Compile Update="DataView\KBotDataView.Input.vb">
      <DependentUpon>KBotDataView.vb</DependentUpon>
    </Compile>
    <Compile Update="DataView\KBotDataView.Layout.vb">
      <DependentUpon>KBotDataView.vb</DependentUpon>
    </Compile>
    <Compile Update="DataView\KBotDataView.Painting.vb">
