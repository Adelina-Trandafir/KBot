<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0-windows</TargetFramework>
    <RootNamespace>KBot.Controls</RootNamespace>
    <AssemblyName>KBot.Controls</AssemblyName>
    <UseWindowsForms>true</UseWindowsForms>
    <OptionStrict>On</OptionStrict>
    <OptionExplicit>On</OptionExplicit>
    <OptionInfer>On</OptionInfer>
    <OptionCompare>Binary</OptionCompare>
  </PropertyGroup>

  <!-- Versiune componentă K-BOT.
       FileVersion: incrementează MANUAL, doar când SE SCHIMBĂ acest proiect. Stă la baza
       comparației din manifestul de update.
       AssemblyVersion: ține-l STABIL. Incrementează doar la o schimbare de interfață care
       rupe compatibilitatea și, când o faci, livrează setul COMPLET, niciodată parțial. -->
  <PropertyGroup>
    <FileVersion>1.35.0.0</FileVersion>
    <AssemblyVersion>1.0.0.0</AssemblyVersion>
  </PropertyGroup>

  <!-- CONVENȚIE DE ORGANIZARE (obligatorie pentru orice control nou)
       TOATE controalele K-BOT trăiesc în acest proiect — nicăieri altundeva. Fiecare
       familie de control are folderul ei, grupată logic (controlul + tipurile lui
       auxiliare: enum-uri, colecții, EventArgs, modele, form-uri ajutătoare):

         Tree\      AdvancedTreeControl (+ partial-uri, ColumnDef, TreeItem, TreeLogger,
                    TooltipTableModel, NodeDebugInfo, FrmNodeDebug)
         DataView\  KBotDataView (+ partial-uri, KBotDataColumn/Row/Collection, enum-urile
                    KBotAggregate/KBotAutoSizeMode/KBotColumnType/KBotFillMode) și
                    DataView\Events\ (KBotCell*/KBotRow*/KBotButtonClickEventArgs)
         Adobe\     vizualizatorul Adobe (AcroPdfHost/AcroPdfSurface + gazduirea nativă)
         NavList\   KBotNavList (+ KBotNavItem/Collection, KBotNavOrientation/Align/
                    Corner/CollapseState)
         Popup\     CustomPopup (+ partial-urile .Painting/.Input, CustomPopupItem/Collection,
                    CustomPopupItemEventArgs, PopupMnemonic)
         CaptionBar\, BusyBar\, Notice\ (+ NoticeKind), Label\ (KBotLabel)
         TextField\  KBotTextField (câmpul de o linie) și KBotTextBox (caseta generală)
         Scroll\     KBotScrollBar (bara de derulare desenată de noi, tematizată)

       KBotThemedForm / KBotShellForm NU sunt controale, ci form-uri de bază: rămân în
       KBot.Theming, împreună cu motorul de teme. -->


  <ItemGroup>
    <Import Include="System.Data" />
    <Import Include="System.Drawing" />
    <Import Include="System.Windows.Forms" />
    <Import Include="KBot.Common" />
  </ItemGroup>

  <!-- Doar pentru GlobalErrorLog (sink-ul global de erori). KBot.Common e stratul cel mai
       jos (referă doar KBot.Domain) => nu introduce ciclu.
       KBot.Theming: controalele se auto-tematizează prin IThemedControl/ThemePalette și
       folosesc ajutoarele din motor (ThemeShapes, NativeMethods.DragMove). Sensul referinței
       e Controls -> Theming și NUMAI așa: KBot.Theming nu referă KBot.Controls, deci nu se
       creează ciclu — de aceea form-urile de bază (KBotThemedForm/KBotShellForm) au rămas
       acolo, iar controalele au venit toate aici. AdvancedTreeControl rămâne ne-tematizat
       (shell-ul îi împinge culorile); convenția IThemedControl se aplică restului. -->
  <ItemGroup>
    <ProjectReference Include="..\KBot.Common\KBot.Common.vbproj" />
    <ProjectReference Include="..\KBot.Theming\KBot.Theming.vbproj" />
  </ItemGroup>

  <ItemGroup>
    <Import Include="KBot.Theming" />
  </ItemGroup>

  <ItemGroup>
    <Compile Update="Resources.Designer.vb">
      <DesignTime>True</DesignTime>
      <AutoGen>True</AutoGen>
      <DependentUpon>Resources.resx</DependentUpon>
    </Compile>
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Update="Resources.resx">
      <CustomToolNamespace>My.Resources</CustomToolNamespace>
      <Generator>ResXFileCodeGenerator</Generator>
      <LastGenOutput>Resources.Designer.vb</LastGenOutput>
    </EmbeddedResource>
  </ItemGroup>
</Project>
