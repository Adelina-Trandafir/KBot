    </Compile>
    <Compile Update="RichText\KBotRichTextEditor.Theming.vb">
      <DependentUpon>KBotRichTextEditor.vb</DependentUpon>
    </Compile>
    <Compile Update="Table\KBotTableLayoutPanel.Dpi.vb">
      <DependentUpon>KBotTableLayoutPanel.vb</DependentUpon>
    </Compile>
    <Compile Update="Table\KBotTableLayoutPanel.Fit.vb">
      <DependentUpon>KBotTableLayoutPanel.vb</DependentUpon>
    </Compile>
    <Compile Update="Tree\AdvancedTreeControl.API.vb">
      <DependentUpon>AdvancedTreeControl.vb</DependentUpon>
    </Compile>
    <Compile Update="Tree\AdvancedTreeControl.ButtonHover.vb">
      <DependentUpon>AdvancedTreeControl.vb</DependentUpon>
    </Compile>
    <Compile Update="Tree\AdvancedTreeControl.ButtonTips.vb">
      <DependentUpon>AdvancedTreeControl.vb</DependentUpon>
    </Compile>
    <Compile Update="Tree\AdvancedTreeControl.ColFilter.vb">
