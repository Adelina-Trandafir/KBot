<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <RootNamespace>KBot.App</RootNamespace>
    <AssemblyName>KBot.App</AssemblyName>
    <UseWindowsForms>true</UseWindowsForms>
    <MyType>WindowsFormsWithCustomSubMain</MyType>
    <StartupObject>KBot.App.Program</StartupObject>
    <OptionStrict>On</OptionStrict>
    <OptionExplicit>On</OptionExplicit>
    <OptionInfer>On</OptionInfer>
    <!-- MSB3825: ImageList-urile din designer (DdfView, OrdView, PlatiView, ReceptiiView,
         RezervariView, AsociereForm, DdfEditDescrierePage) isi tin imaginile in .resx ca
         ImageStream, format citit de WinForms cu propriul lui cititor, nu cu BinaryFormatter
         generic (merge si pe .NET 9). Datele sunt compilate in exe, nu vin de afara.
         Alternativa reala: icoanele ca PNG in Resources.resx + il.Images.Add(...) in ctor. -->
    <GenerateResourceWarnOnBinaryFormatterUse>false</GenerateResourceWarnOnBinaryFormatterUse>
    <!-- BouncyCastle 1.8.9, transitiv prin KBot.Xfa → iTextSharp. Motivarea completă e în
         src\KBot.Xfa\KBot.Xfa.vbproj, la PackageReference-ul lui iTextSharp. -->
    <NoWarn>$(NoWarn);NU1701</NoWarn>
    <OptionCompare>Binary</OptionCompare>
    <ApplicationIcon>kbot.ico</ApplicationIcon>
  </PropertyGroup>

  <!-- Versiune componentă K-BOT.
       FileVersion: incrementează MANUAL, doar când SE SCHIMBĂ acest proiect. Stă la baza
       comparației din manifestul de update.
       AssemblyVersion: ține-l STABIL. Incrementează doar la o schimbare de interfață care
       rupe compatibilitatea și, când o faci, livrează setul COMPLET, niciodată parțial. -->
  <PropertyGroup>
    <FileVersion>1.1.5.5</FileVersion>
    <AssemblyVersion>1.0.0.0</AssemblyVersion>
  </PropertyGroup>

  <ItemGroup>
    <Import Include="System.Data" />
    <Import Include="System.Drawing" />
    <Import Include="System.Windows.Forms" />
    <!-- KBotMessage: poarta unica prin care se arata o caseta operatorului si, in
         aceeasi miscare, se scrie in Logs\mesaje_operator.log. Import la nivel de
         proiect ca regula sa fie disponibila in ORICE fisier, fara sa depinda de lista
         de Imports a fiecaruia. -->
    <Import Include="KBot.Theming" />
  </ItemGroup>

  <!-- Resurse proiect: fixăm numele manifest la „KBot.App.Resources” ca ResourceManager-ul
       din My Project\Resources.Designer.vb (scris de mână, fiindcă generatorul VS nu rulează
       sub dotnet build) să-l regăsească. Expune My.Resources.kbot_64.

       Generator/CustomToolNamespace NU schimbă nimic la dotnet build — sunt pentru Visual
       Studio și sunt OBLIGATORII: fără ele, designer-ul nu știe că resursele proiectului sunt
       cele „My” de VB, ghicește tipul «KBot.App.Resources» și scrie în MainForm.Designer.vb
       «Resources.calendar». Cum InitializeComponent are deja o variabilă locală «resources»
       (ComponentResourceManager) iar VB nu e case-sensitive, acel «Resources.calendar» se
       leagă de variabila locală și nu mai compilează. Cu metadatele astea, designer-ul emite
       forma canonică «My.Resources.Resources.calendar», care nu se poate ciocni. -->
  <ItemGroup>
    <EmbeddedResource Update="My Project\Resources.resx">
      <LogicalName>KBot.App.Resources.resources</LogicalName>
      <Generator>VbMyResourcesResXFileCodeGenerator</Generator>
      <CustomToolNamespace>My.Resources</CustomToolNamespace>
      <LastGenOutput>Resources.Designer.vb</LastGenOutput>
      <SubType>Designer</SubType>
    </EmbeddedResource>
  </ItemGroup>

  <!-- SLICE-0086-07: acest .resx gol apartine unui partial al KbotForm, nu unui formular
       separat. Compilarea lui ar dubla resursa KBot.App.KbotForm (MSB3577). -->
  <ItemGroup>
    <EmbeddedResource Remove="KBotForm\Documents\KbotForm.Receptii.resx" />
    <None Include="KBotForm\Documents\KbotForm.Receptii.resx" />
  </ItemGroup>

  <!-- Two harness forms own a .resx; with their whole class inside #If DEBUG, MSBuild cannot find the class
       to name the resource (MSB3042). So the files carry no #If and are left out of non-Debug builds here. -->
  <ItemGroup Condition="'$(Configuration)' != 'Debug'">
    <Compile Remove="HarnessTests\DdfSectiuneaBHarnessForm*.vb;HarnessTests\DdfFluxServerHarnessForm*.vb;HarnessTests\PdfSigningHarnessForm*.vb;HarnessTests\RecordingPdfApi.vb;HarnessTests\PdfSignatureReport.vb;HarnessTests\PdfSaveTimeline.vb" />
    <EmbeddedResource Remove="HarnessTests\DdfSectiuneaBHarnessForm.resx;HarnessTests\PdfSigningHarnessForm.resx" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\KBot.Domain\KBot.Domain.vbproj" />
    <ProjectReference Include="..\KBot.Common\KBot.Common.vbproj" />
    <ProjectReference Include="..\KBot.Api\KBot.Api.vbproj" />
    <ProjectReference Include="..\KBot.LocalStore\KBot.LocalStore.vbproj" />
    <ProjectReference Include="..\KBot.Forexe\KBot.Forexe.vbproj" />
    <ProjectReference Include="..\KBot.Forexe.Editor\KBot.Forexe.Editor.vbproj" />
    <!-- Direct, nu doar tranzitiv prin KBot.Controls: designerul WinForms rezolva clasa
         de baza (KBotThemedForm / KBotThemedUserControl) DOAR din referintele directe. -->
    <ProjectReference Include="..\KBot.Theming\KBot.Theming.vbproj" />
    <ProjectReference Include="..\KBot.Controls\KBot.Controls.vbproj" />
    <ProjectReference Include="..\KBot.Xfa\KBot.Xfa.vbproj" />
    <!-- Slice 00EF-67: E-Factura nu mai e proiect separat; codul lui e in EFactura\ (vezi mai jos). -->
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="8.0.1" />
    <!-- Playwright: referință directă pe versiunea fixată în KBot.Forexe (1.49.0).
         Garantează că folderul .playwright\ (driver node + cli.js) ajunge în output-ul
         de build ȘI de publish la rădăcina alături de KBot.App.exe. NU înlocuiește
         referința din KBot.Forexe (acolo rămâne — Forexe e cel care folosește Playwright).
         Versiunea TREBUIE să fie identică cu cea din KBot.Forexe (vezi nota despre
         selecția automată a certificatului acolo). -->
    <PackageReference Include="Microsoft.Playwright" Version="1.49.0" />
    <!-- Slice 0000-01: the help topics are Markdown; Markdig turns them into the help window's
         pages and into the exported manual. -->
    <PackageReference Include="Markdig" Version="0.45.0" />
    <!-- Slice 00EF-67: the PDF of the classic invoice and of the ANAF error (EFactura\...\FacturaPdf) uses iTextSharp directly;
         same version as KBot.Xfa. -->
    <PackageReference Include="iTextSharp" Version="5.5.13.3" NoWarn="NU1701" />
    <!-- Slice 0103-06's OLE DB package (writing the budget into the unit's Access file) moved with the
         Access code into KBot.Access (slice 0104): this project no longer talks to Access itself. -->
  </ItemGroup>

  <!-- Slice 0000-01: help topics and their pictures. Written under HelpContent\, shipped as
       <AppDir>\Help\ (build and publish), where HelpLibrary reads them. -->
  <ItemGroup>
    <None Include="HelpContent\**\*" Link="Help\%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

  <!-- Slice 0112: the message catalog (one entry per message box call). Edited entries replace the wording
       of their call at run time (KBotMessage -> MessageOverrides), so it ships as <AppDir>\Config\ in
       every configuration. Made and edited by tools\MessageCatalog\scan.js + the Debug catalog form. -->
  <ItemGroup>
    <None Include="Config\mesaje_catalog.json" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

  <!-- 01.10.2026: the release notes of every version, shipped as <AppDir>\Noutati\NOUTATI.md for
       «Setari -> Istoric versiuni» and the «Ce e nou?» row of the help popup. -->
  <ItemGroup>
    <None Include="..\..\docs\release-notes\NOUTATI.md" Link="Noutati\NOUTATI.md" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

  <!-- Slice 0078-15 (06.10.2026): the plain PDF (no form, no scripts) the ActiveX viewer loads into every new control
       BEFORE the real document (AcroPdfViewer.PrimerPath), shipped as <AppDir>\empty_pdf.pdf. -->

  <!-- Slice 0104: the Access component (everything that talks to the Access files) is NOT referenced by this
       project: the application finds KBot.Access.dll at run time (KBot.Common.AccessBridge), so a package
       can be built without it. ReferenceOutputAssembly=false only makes the build order right and, below,
       copies the component next to the exe for a development run. The property KBotAudience set to
       NonAccess (what publish-release.ps1 passes for a non-Access package) leaves it out of the build
       altogether. -->
  <PropertyGroup>
    <KBotAudience Condition="'$(KBotAudience)' == ''">Access</KBotAudience>
  </PropertyGroup>
  <ItemGroup Condition="'$(KBotAudience)' != 'NonAccess'">
    <ProjectReference Include="..\KBot.Access\KBot.Access.vbproj" ReferenceOutputAssembly="false" />
  </ItemGroup>
  <Target Name="CopyAccessComponent" AfterTargets="Build" Condition="'$(KBotAudience)' != 'NonAccess'">
    <PropertyGroup>
      <_AccessOut>$(MSBuildProjectDirectory)\..\KBot.Access\bin\$(Configuration)\net8.0-windows\</_AccessOut>
    </PropertyGroup>
    <ItemGroup>
      <_AccessAll Include="$(_AccessOut)**\*.*" />
      <!-- KBot.Access's own files always; anything else (its OLE DB package) only when the app does not have it. -->
      <_AccessToCopy Include="@(_AccessAll)" Condition="'%(Filename)' == 'KBot.Access' Or ('%(Filename)' != 'KBot.Common' And '%(Filename)' != 'KBot.Domain' And !Exists('$(OutDir)%(RecursiveDir)%(Filename)%(Extension)'))" />
    </ItemGroup>
    <Copy SourceFiles="@(_AccessToCopy)" DestinationFiles="@(_AccessToCopy->'$(OutDir)%(RecursiveDir)%(Filename)%(Extension)')" SkipUnchangedFiles="true" />
  </Target>

  <!-- Banc de probă (Dev Harness): referit DOAR pe Debug → zero amprentă în Release. -->
  <ItemGroup Condition="'$(Configuration)'=='Debug'">
    <ProjectReference Include="..\KBot.DevHarness\KBot.DevHarness.vbproj" />
  </ItemGroup>
  <ItemGroup>
    <Compile Update="My Project\Resources.Designer.vb">
      <DesignTime>True</DesignTime>
      <AutoGen>True</AutoGen>
      <DependentUpon>Resources.resx</DependentUpon>
    </Compile>
  </ItemGroup>


  <!-- Slice 0086: every partial file of a form / control nests under its main file in Solution
