    <Compile Update="KBotForm\KbotForm.Units.vb">
      <DependentUpon>KbotForm.vb</DependentUpon>
    </Compile>

	  <Compile Update="Avacont\AvacontMain.Sidebar.vb">
		  <DependentUpon>AvacontMain.vb</DependentUpon>
	  </Compile>
      <Compile Update="Avacont\AvacontMain.Navigation.vb">
