<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <RootNamespace>KBot.Migrator</RootNamespace>
    <AssemblyName>KBot.Migrator</AssemblyName>
    <UseWindowsForms>true</UseWindowsForms>
    <!-- x64, NOT AnyCPU. The ACE provider is 64-bit only on this estate; AnyCPU with
         prefer-32-bit fails at OleDbConnection.Open with "provider is not registered".
         Slice 0045-01 verified ACE 16.0 and 12.0 are both registered 64-bit here. -->
    <PlatformTarget>x64</PlatformTarget>
    <MyType>WindowsFormsWithCustomSubMain</MyType>
    <StartupObject>KBot.Migrator.Program</StartupObject>
    <OptionStrict>On</OptionStrict>
    <OptionExplicit>On</OptionExplicit>
    <OptionInfer>On</OptionInfer>
    <OptionCompare>Binary</OptionCompare>
  </PropertyGroup>

  <!-- Versiune componentă K-BOT.
       FileVersion: incrementează MANUAL, doar când SE SCHIMBĂ acest proiect. Stă la baza
       comparației din manifestul de update.
       AssemblyVersion: ține-l STABIL. Incrementează doar la o schimbare de interfață care
       rupe compatibilitatea și, când o faci, livrează setul COMPLET, niciodată parțial. -->
  <PropertyGroup>
    <FileVersion>1.3.0.0</FileVersion>
    <AssemblyVersion>1.0.0.0</AssemblyVersion>
  </PropertyGroup>

  <ItemGroup>
    <Import Include="System.Drawing" />
    <Import Include="System.Windows.Forms" />
  </ItemGroup>

  <!-- Slice 0045: the migrator talks to Access and MariaDB itself. No Flask, no HTTP,
       no pushing the .accdb to the server.

       System.Data.OleDb is a NuGet package on .NET 8 - OleDb left the BCL after
       .NET Framework. MySqlConnector over MySql.Data: MIT rather than GPL-with-
       exception, and a drop-in for the ADO.NET interfaces (decision D10). -->
  <ItemGroup>
    <PackageReference Include="System.Data.OleDb" Version="8.0.0" />
    <PackageReference Include="MySqlConnector" Version="2.6.2" />
  </ItemGroup>

  <!-- Slice 0045 reversed slice 0044's whole shape. The tool no longer pushes the .accdb
       to the server and talks HTTP; it opens Access AND MariaDB itself. So the KBot.Api
       reference is gone (there is no server address and no API key any more - the MariaDB
       credentials are fields on the one form), and the two data packages above are the
       point of the project rather than something deliberately avoided.

       KBot.Theming brings the theme engine plus KBotThemedForm. KBot.Forexe - where the
       KBotTheme facade lives - is avoided on purpose: it would drag Playwright into a
       utility that opens no browser. -->
  <ItemGroup>
    <ProjectReference Include="..\KBot.Common\KBot.Common.vbproj" />
    <ProjectReference Include="..\KBot.Theming\KBot.Theming.vbproj" />
    <!-- KBotToolTip (the house rule is that floating labels are NOT made with
         System.Windows.Forms.ToolTip, which cannot be themed) and KBotDataView: every
         grid on this form is a K-BOT grid, never a bare DataGridView. -->
    <ProjectReference Include="..\KBot.Controls\KBot.Controls.vbproj" />
  </ItemGroup>

</Project>
