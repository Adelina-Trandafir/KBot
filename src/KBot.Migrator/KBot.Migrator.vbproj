<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <RootNamespace>KBot.Migrator</RootNamespace>
    <AssemblyName>KBot.Migrator</AssemblyName>
    <UseWindowsForms>true</UseWindowsForms>
    <!-- x64, NOT AnyCPU. The ACE provider is 64-bit only on this estate; AnyCPU with
         prefer-32-bit fails at OleDbConnection.Open with "provider is not registered".
         Slice 0045-01 verified ACE 16.0 and 12.0 are both registered 64-bit here. -->
    <PlatformTarget>x64</PlatformTarget>
    <MyType>WindowsFormsWithCustomSubMain</MyType>
    <StartupObject>KBot.Migrator.Program</StartupObject>
    <OptionStrict>On</OptionStrict>
    <OptionExplicit>On</OptionExplicit>
    <OptionInfer>On</OptionInfer>
    <OptionCompare>Binary</OptionCompare>
  </PropertyGroup>

  <!-- Versiune componentă K-BOT.
       FileVersion: incrementează MANUAL, doar când SE SCHIMBĂ acest proiect. Stă la baza
       comparației din manifestul de update.
       AssemblyVersion: ține-l STABIL. Incrementează doar la o schimbare de interfață care
       rupe compatibilitatea și, când o faci, livrează setul COMPLET, niciodată parțial. -->
  <PropertyGroup>
    <FileVersion>1.7.0.0</FileVersion>
    <AssemblyVersion>1.0.0.0</AssemblyVersion>
  </PropertyGroup>

  <ItemGroup>
    <Import Include="System.Drawing" />
    <Import Include="System.Windows.Forms" />
  </ItemGroup>

  <!-- Slice 0045: the migrator opens Access and MariaDB itself. Nothing is pushed to the
       server and no migration data travels over HTTP. The ONE exception is building the
       structure of a database somebody created empty, which is the Python schema tool's job
       and only runs where the databases are - one call to /api/migrare/schema-sync, over
       HttpClient, which is in the shared framework and needs no package.

       System.Data.OleDb is a NuGet package on .NET 8 - OleDb left the BCL after
       .NET Framework. MySqlConnector over MySql.Data: MIT rather than GPL-with-
       exception, and a drop-in for the ADO.NET interfaces (decision D10). -->
  <ItemGroup>
    <PackageReference Include="System.Data.OleDb" Version="8.0.0" />
    <PackageReference Include="MySqlConnector" Version="2.6.2" />
  </ItemGroup>

  <!-- Slice 0045 reversed slice 0044's whole shape. The tool no longer pushes the .accdb
       to the server; it opens Access AND MariaDB itself, and the two data packages above
       are the point of the project rather than something deliberately avoided.

       The KBot.Api reference stayed gone even when the schema-sync call brought a little
       HTTP back. KBot.Api is the APPLICATION's client - bearer tokens, a login, a hostname
       constant - and this needs none of that: one route, one X-Api-Key header, one address
       the operator types. SchemaSyncClient carries its own HttpClient rather than dragging
       in a project built for a different conversation.

       KBot.Theming brings the theme engine plus KBotThemedForm. KBot.Forexe - where the
       KBotTheme facade lives - is avoided on purpose: it would drag Playwright into a
       utility that opens no browser. -->
  <ItemGroup>
    <ProjectReference Include="..\KBot.Common\KBot.Common.vbproj" />
    <ProjectReference Include="..\KBot.Theming\KBot.Theming.vbproj" />
    <!-- KBotToolTip (the house rule is that floating labels are NOT made with
         System.Windows.Forms.ToolTip, which cannot be themed) and KBotDataView: every
         grid on this form is a K-BOT grid, never a bare DataGridView. -->
    <ProjectReference Include="..\KBot.Controls\KBot.Controls.vbproj" />
  </ItemGroup>
  <ItemGroup>
    <Compile Update="My Project\Resources.Designer.vb">
      <DesignTime>True</DesignTime>
      <AutoGen>True</AutoGen>
      <DependentUpon>Resources.resx</DependentUpon>
    </Compile>
  </ItemGroup>
  <ItemGroup>
    <EmbeddedResource Update="My Project\Resources.resx">
      <CustomToolNamespace>My.Resources</CustomToolNamespace>
      <Generator>VbMyResourcesResXFileCodeGenerator</Generator>
      <LastGenOutput>Resources.Designer.vb</LastGenOutput>
    </EmbeddedResource>
  </ItemGroup>

</Project>
