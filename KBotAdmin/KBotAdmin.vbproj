<Project Sdk="Microsoft.NET.Sdk">

  <!-- SLICE-ME01. KBotAdmin: the owner's administration program (databases, accounts, rights, schema
       difference and sync, logs). It is NOT part of K-BOT's delivery and must stay out of it:
       nothing here is referenced by KBot.App, KBot.sln or any publish / setup / update script, and
       no publish script may ever pick it up. It builds on its own:
           dotnet build KBotAdmin\KBotAdmin.vbproj
       It talks to the server only over SSH (no database port is ever opened). It reuses K-BOT's own
       controls and theme engine through project references; nothing flows the other way. -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <RootNamespace>KBotAdmin</RootNamespace>
    <AssemblyName>KBotAdmin</AssemblyName>
    <StartupObject>Sub Main</StartupObject>
    <MyType>Empty</MyType>
    <OptionStrict>On</OptionStrict>
    <OptionExplicit>On</OptionExplicit>
    <OptionInfer>On</OptionInfer>
    <OptionCompare>Binary</OptionCompare>
    <Nullable>disable</Nullable>
    <AssemblyVersion>1.0.0.0</AssemblyVersion>
    <FileVersion>1.1.0.0</FileVersion>
    <ApplicationIcon>KBotAdmin.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <Import Include="System.Drawing" />
    <Import Include="System.Windows.Forms" />
    <Import Include="System.Collections.Generic" />
    <Import Include="System.Linq" />
    <Import Include="System.Threading.Tasks" />
    <Import Include="KBot.Common" />
    <Import Include="KBot.Theming" />
    <Import Include="KBot.Controls" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="SSH.NET" Version="2026.0.0" />
    <!-- ME02: the key of the local backup can be kept on this PC, protected by the Windows account (DPAPI). -->
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="8.0.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\src\KBot.Common\KBot.Common.vbproj" />
    <ProjectReference Include="..\src\KBot.Theming\KBot.Theming.vbproj" />
    <ProjectReference Include="..\src\KBot.Controls\KBot.Controls.vbproj" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="KBotAdmin.ico" LogicalName="KBotAdmin.ico" />
  </ItemGroup>

  <!-- ME01-05: the ribbon icons come from K-BOT's own icon stock, linked (not copied) so there is one source.
       LogicalName "icon.<name>" is what AdminIcons.Get("<name>") asks for. -->
  <ItemGroup>
    <EmbeddedResource Include="..\src\KBot.App\Resources\database.png" LogicalName="icon.database" />
    <EmbeddedResource Include="..\src\KBot.App\Resources\Umut-Pulat-Tulliana-2-File-temporary.32.png" LogicalName="icon.once" />
    <EmbeddedResource Include="..\src\KBot.App\Resources\Jonas-Rask-Danish-Royalty-Free-Refresh.32.png" LogicalName="icon.sync" />
    <EmbeddedResource Include="..\src\KBot.App\Resources\export.png" LogicalName="icon.clone" />
    <EmbeddedResource Include="..\src\KBot.App\Resources\Fatcow-Farm-Fresh-Pdf-exports.24.png" LogicalName="icon.reports" />
    <EmbeddedResource Include="..\src\KBot.App\Resources\Wefunction-Woofunction-Window-app-list-info.32.png" LogicalName="icon.logs" />
    <EmbeddedResource Include="..\src\KBot.App\Resources\istoric_32.png" LogicalName="icon.journal" />
    <EmbeddedResource Include="..\src\KBot.App\Forexe\Receptii_Icons\Fatcow-Farm-Fresh-Chart-curve.32.png" LogicalName="icon.visits" />
    <EmbeddedResource Include="..\src\KBot.App\Resources\Semlabs-Web-Blog-Earth-search.48_resized.png" LogicalName="icon.server" />
    <EmbeddedResource Include="..\src\KBot.App\Resources\Fatcow-Farm-Fresh-Check-boxes.32.png" LogicalName="icon.requests" />
    <EmbeddedResource Include="..\src\KBot.App\Resources\Umut-Pulat-Tulliana-2-File-locked.32.png" LogicalName="icon.login" />
    <EmbeddedResource Include="..\src\KBot.App\Resources\credit-card.png" LogicalName="icon.rights" />
    <EmbeddedResource Include="..\src\KBot.App\Resources\binvoice.png" LogicalName="icon.rights_ad" />
    <EmbeddedResource Include="..\src\KBot.App\Resources\cells.png" LogicalName="icon.rights_vr" />
    <EmbeddedResource Include="..\src\KBot.App\Resources\plus_green.png" LogicalName="icon.account_add" />
    <EmbeddedResource Include="..\src\KBot.App\Resources\right_32.png" LogicalName="icon.account_grant" />
    <EmbeddedResource Include="..\src\KBot.App\Resources\kbot_64.png" LogicalName="icon.account_role" />
    <EmbeddedResource Include="..\src\KBot.App\Resources\save_32.png" LogicalName="icon.backup_server" />
    <EmbeddedResource Include="..\src\KBot.App\Resources\folder_open.png" LogicalName="icon.backup_local" />
    <EmbeddedResource Include="..\src\KBot.App\Resources\ef_iesiri.png" LogicalName="icon.publish" />
    <EmbeddedResource Include="..\src\KBot.App\Forexe\Receptii_Icons\Fatcow-Farm-Fresh-Brick-link.32.png" LogicalName="icon.md_history" />
  </ItemGroup>

  <ItemGroup>
    <None Update="admin_settings.example.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

</Project>
