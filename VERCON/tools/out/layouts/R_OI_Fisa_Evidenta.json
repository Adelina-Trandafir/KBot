{"name":"OI_Fisa_Evidenta","kind":"report","family":"OI evidenta/inventar","file":"Reports/OI_Fisa_Evidenta.txt","caption":"","recordSource":"SELECT X.Denumire, X.Adresa, X.Masina, OI_Evidenta.Numar, OI_Evidenta.Data, X.CodProdus, X.DenumireProdus, X.UM, X.PUTVA, X.CF, X.VF FROM (SELECT OI_Evidenta.IDC, Min(IIf(Left([numar],2)=\"BP\" Or \"BT\",[ID],0)) AS IDX, OI_Evidenta.Masina, OI_Evidenta.Denumire, Clienti.Adresa, OI_Evidenta.CodProdus, OI_Evidenta.DenumireProdus, OI_Evidenta.UM, OI_Evidenta.PUTVA, Sum([c0]+[c1]-[c2]) AS CF, Sum([v0]+[v1]-[v2]) AS VF FROM OI_Evidenta INNER JOIN Clienti ON OI_Evidenta.IDC = Clienti.IDC GROUP BY OI_Evidenta.IDC, OI_Evidenta.Masina, OI_Evidenta.Denumire, Clienti.Adresa, OI_Evidenta.CodProdus, OI_Evidenta.DenumireProdus, OI_Evidenta.UM, OI_Evidenta.PUTVA HAVING (((OI_Evidenta.IDC) In (select idc from [tmpSFP] where s=true group by idc)) AND ((Sum([c0]+[c1]-[c2]))<>0)) ORDER BY OI_Evidenta.Masina, OI_Evidenta.Denumire, OI_Evidenta.DenumireProdus) AS X INNER JOIN OI_Evidenta ON (X.IDX = OI_Evidenta.ID) AND (X.CodProdus = OI_Evidenta.CodProdus) GROUP BY X.Denumire, X.Adresa, X.Masina, OI_Evidenta.Numar, OI_Evidenta.Data, X.CodProdus, X.DenumireProdus, X.UM, X.PUTVA, X.CF, X.VF; ","width":15111,"sections":[{"name":"PageHeaderSection","type":"PageHeader","height":2856,"line":197,"controls":[{"t":"TextBox","n":"Text1","cap":"","cs":"=DLookUp(\"Firma\",\"caleTemp\")","rs":"","so":"","x":1151,"y":59,"w":4521,"h":315,"fs":12,"fw":400,"fc":"3484194","vis":true,"line":207,"ev":""},{"t":"Label","n":"Label2","cap":"Unitatea","cs":"","rs":"","so":"","x":56,"y":56,"w":1092,"h":315,"fs":8,"fw":700,"vis":true,"line":235,"ev":""},{"t":"TextBox","n":"Primitor","cap":"","cs":"Denumire","rs":"","so":"","x":56,"y":374,"w":5616,"h":405,"fs":12,"fw":400,"fc":"3484194","vis":true,"line":262,"ev":""},{"t":"Label","n":"Label6","cap":"FIŞĂ DE EVIDENŢĂ A MATERIALELOR DE NATURA OBIECTELOR DE INVENTAR ÎN FOLOSINŢĂ","cs":"","rs":"","so":"","x":6060,"y":60,"w":9030,