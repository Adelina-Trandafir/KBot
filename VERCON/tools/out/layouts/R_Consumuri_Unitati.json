{"name":"Consumuri_Unitati","kind":"report","family":"Centralizatoare","file":"Reports/Consumuri_Unitati.txt","caption":"","recordSource":"SELECT X.IDC, X.Primitor, X.IdMasina, X.Masina, X.CodProdus, X.Denumire, X.UM, X.Cant, X.PUTVA, [Cant]*[putva] AS Valoare FROM (SELECT Masini.IdMasina, Masini.Masina, Clienti.IDC, Clienti.Denumire AS Primitor, Iesiri.CodProdus, Iesiri.Denumire, Iesiri.UM, Sum(Iesiri.Cant) AS Cant, Iesiri.PUTVA FROM Masini INNER JOIN ((Clienti INNER JOIN Iesiri_H ON Clienti.IDC = Iesiri_H.IDC) INNER JOIN Iesiri ON Iesiri_H.IdBonConsum = Iesiri.IdBonConsum) ON Masini.IdMasina = Iesiri_H.IdMasina WHERE (((Iesiri_H.DataBC) Between [Forms]![SFP]![di] And [Forms]![SFP]![dsf])) GROUP BY Masini.IdMasina, Masini.Masina, Clienti.IDC, Clienti.Denumire, Iesiri.CodProdus, Iesiri.Denumire, Iesiri.UM, Iesiri.PUTVA HAVING (((Clienti.IDC) In (select IDC From [tmpSFP] WHERE S=True GROUP BY IDC))) ORDER BY Iesiri.Denumire) AS X ORDER BY X.Primitor, X.Denumire; ","width":9525,"sections":[{"name":"PageHeaderSection","type":"PageHeader","height":2244,"line":202,"controls":[{"t":"TextBox","n":"Text18","cap":"","cs":"=DLookUp(\"Firma\",\"caletemp\")","rs":"","so":"","x":0,"y":0,"w":9522,"h":306,"fs":12,"fw":700,"bs":"0","vis":true,"line":212,"ev":""},{"t":"TextBox","n":"Text49","cap":"","cs":"=[Forms]![sfp]![di] & \" - \" & [Forms]![sfp]![dsf]","rs":"","so":"","x":0,"y":984,"w":9522,"h":450,"fs":14,"fw":700,"bs":"0","vis":true,"line":241,"ev":""},{"t":"Label","n":"Label19","cap":"Situație consumuri / conturi","cs":"","rs":"","so":"","x":0,"y":504,"w":9522,"h":480,"fs":18,"fw":700,"vis":true,"line":274,"ev":""},{"t":"Label","n":"L1","cap":"Denumire produs","cs":"","rs":"","so":"","x":408,"y":1968,"w":3840,"h":276,"fs":10,"fw":700,"bc":"15527148","bs":"1","vis":true,"line":303,"ev":""},{"t":"Label","n":"L2","cap":"U/M","cs":"","rs":"","so":"","x":4248,"y":1968,"w":960,"h":276,"fs":10,"fw":700,"bc":"15527148","bs":"1","vis":true,"line":333,"ev":""},{"t":"Label","n":"L3","c