{"name":"Nota_Comanda","kind":"report","family":"Comenzi/referate/situatii","file":"Reports/Nota_Comanda.txt","caption":"","recordSource":"SELECT Furnizori.Denumire, NIR.DataFc, Produse.denumirep AS DenumireProdus, Produse.UM, Sum(Intrari.Cant) AS SumOfCant, Sum(Intrari.ValoareCUTVA) AS SumOfValoareCUTVA FROM (Produse INNER JOIN ((Furnizori INNER JOIN (NIR INNER JOIN Intrari ON NIR.IdIntrare = Intrari.IdIntrare) ON Furnizori.IDF = NIR.IDF) INNER JOIN ProduseP ON Intrari.IdProdus = ProduseP.IdProdus) ON Produse.ID = ProduseP.ID) INNER JOIN tmpSFP ON ProduseP.IdProdus = tmpSFP.CodProdus WHERE (((NIR.Data) Between [forms]![sfp]![di] And [forms]![sfp]![dsf]) AND ((tmpSFP.S)=True) AND ((NIR.IdIntrare) In (SELECT IdIntrare FROM [tmpSFP] WHERE S=True GROUP BY IdIntrare))) GROUP BY Furnizori.Denumire, NIR.DataFc, Produse.denumirep, Produse.UM HAVING (((Sum(Intrari.ValoareCUTVA))>0)) ORDER BY Produse.denumirep;","width":10788,"sections":[{"name":"ReportHeader","type":"FormHeader","height":0,"line":163,"controls":[]},{"name":"PageHeaderSection","type":"PageHeader","height":2987,"line":171,"controls":[{"t":"TextBox","n":"Text2","cap":"","cs":"=DLookUp(\"firma\",\"caletemp\")","rs":"","so":"","x":0,"y":0,"w":4176,"h":285,"fs":10,"fw":400,"vis":true,"line":178,"ev":""},{"t":"TextBox","n":"Label6","cap":"","cs":"=\"CĂTRE <B>\" & [DENUMIRE] & \"</B>\"","rs":"","so":"","x":0,"y":1962,"w":10770,"h":345,"fs":8,"fw":400,"bs":"0","vis":true,"line":195,"ev":""},{"t":"Label","n":"Label7","cap":"NR. CRT.","cs":"","rs":"","so":"","x":1303,"y":2699,"w":915,"h":285,"fs":10,"fw":400,"bc":"15527148","bs":"1","vis":true,"line":216,"ev":""},{"t":"Label","n":"Label8","cap":"Denumire","cs":"","rs":"","so":"","x":2218,"y":2700,"w":4425,"h":285,"fs":10,"fw":400,"bc":"15527148","bs":"1","vis":true,"line":239,"ev":""},{"t":"Label","n":"Label9","cap":"U/ M","cs":"","rs":"","so":"","x":6643,"y":2701,"w":840,"h":285,"fs":10,"fw":400,"bc":"15527148","bs":"1","vis":true,"line":262,"ev":""},{"t":"Label","n"