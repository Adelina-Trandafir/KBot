{"name":"MF_LISTA_INVENTAR","kind":"report","family":"MF","file":"Reports/MF_LISTA_INVENTAR.txt","caption":"","recordSource":"SELECT X.IdMasina, X.IDC, X.Masina, X.Denumire, X.Adresa, X.CodProdus, X.DENP, X.UMP, X.PT, Sum([CI]+[CCIn]-[CCOut]) AS CF, Sum([vi]+[vcin]-[vcout]) AS VF, ProduseP.COD, Produse.CC FROM (SELECT Clienti.Adresa,OI_Union.IDC, Clienti.Denumire, OI_Union.IdMasina, Masini.Masina, OI_Union.CodProdus, OI_Union.DenumireProdus AS DENP, Nz([UM],\"Buc\") AS UMP, OI_Union.PUTVA AS PT, Sum(OI_Union.C0) AS CI, Sum(OI_Union.V0) AS VI, Sum(OI_Union.C1) AS CCIn, Sum(OI_Union.V1) AS VCIn, Sum(OI_Union.V2) AS CCOut, Sum(OI_Union.C2) AS VCOut FROM (OI_Union INNER JOIN Masini ON OI_Union.IdMasina = Masini.IdMasina) INNER JOIN Clienti ON OI_Union.IDC = Clienti.IDC GROUP BY Clienti.Adresa,OI_Union.IDC, Clienti.Denumire, OI_Union.IdMasina, Masini.Masina, OI_Union.CodProdus, OI_Union.DenumireProdus, Nz([UM],\"Buc\"), OI_Union.PUTVA HAVING (((OI_Union.IDC) In (select IDC from [tmpSFP] where s=true group by idc))) ORDER BY OI_Union.DenumireProdus) AS X INNER JOIN (ProduseP INNER JOIN Produse ON ProduseP.ID = Produse.ID) ON X.CodProdus = ProduseP.IdProdus GROUP BY X.IdMasina, X.IDC, X.Masina, X.Denumire, X.Adresa, X.CodProdus, X.DENP, X.UMP, X.PT, ProduseP.COD, Produse.CC HAVING (((X.CodProdus) In (SELECT Codprodus from [tmpSFP] WHERE S=TRue)) AND ((Sum([CI]+[CCIn]-[CCOut]))<>0)) ORDER BY X.DENP; ","width":15405,"sections":[{"name":"PageHeaderSection","type":"PageHeader","height":2256,"line":191,"controls":[{"t":"Label","n":"Label0","cap":"LISTĂ DE INVENTARIERE MIJLOACE FIXE","cs":"","rs":"","so":"","x":0,"y":0,"w":15251,"h":735,"fs":14,"fw":700,"vis":true,"line":198,"ev":""},{"t":"TextBox","n":"Text3","cap":"","cs":"=UCase(DLookUp(\"Firma\",\"CaleTemp\"))","rs":"","so":"","x":0,"y":1077,"w":4536,"h":345,"fs":8,"fw":400,"bs":"0","vis":true,"line":217,"ev":""},{"t":"Label","n":"Label4","cap":"UNITATEA","cs":"","rs":"","so":"","x":0,"y":737,"w":4530,"h":690,"fs":12,"fw":70