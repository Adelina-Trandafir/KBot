{"name":"Bon_Consum","kind":"report","family":"BC/BR","file":"Reports/Bon_Consum.txt","caption":"","recordSource":"SELECT Iesiri_H.IdBonConsum, Masini.Masina, Clienti.Denumire AS Client, Iesiri_H.NumarBC AS NrFact, Iesiri_H.DataBC, Day([databc]) AS Ziua, Month([databc]) AS Luna, Year([databc]) AS Anul, Iesiri_H.ValoareBC, ProduseP.IdProdus, Produse.DenumireP, Produse.UM, Iesiri.Cant, Iesiri.PUTVA AS Pret, Iesiri.ValoareCUTVA AS Valoare, Iesiri_H.Expl FROM ((Masini INNER JOIN Produse ON Masini.IdMasina = Produse.IdMasina) INNER JOIN (((Clienti INNER JOIN Iesiri_H ON Clienti.IDC = Iesiri_H.IDC) INNER JOIN Iesiri ON Iesiri_H.IdBonConsum = Iesiri.IdBonConsum) INNER JOIN ProduseP ON Iesiri.IdProdus = ProduseP.IdProdus) ON Produse.ID = ProduseP.ID) INNER JOIN tmpSFP ON (tmpSFP.CodProdus = ProduseP.IdProdus) AND (Iesiri.IdBonConsum = tmpSFP.IdBonConsum) WHERE (((Iesiri_H.IdBonConsum) In (select IdBonConsum FROM [tmpSFP] WHERE S=True GROUP BY IdBonConsum)) AND ((Iesiri_H.DataBC) Between [forms]![SFP]![di] And [Forms]![SFP]![dsf]) AND ((tmpSFP.S)=True)) ORDER BY Iesiri_H.IdBonConsum, Produse.DenumireP;","width":10731,"sections":[{"name":"PageHeaderSection","type":"PageHeader","height":0,"line":166,"controls":[]},{"name":"GroupHeader0","type":"BreakHeader","height":2238,"line":173,"controls":[{"t":"TextBox","n":"Text0","cap":"","cs":"=DLookUp(\"Firma\",\"caleTemp\")","rs":"","so":"","x":0,"y":0,"w":3459,"h":510,"fs":10,"fw":700,"vis":true,"line":181,"ev":""},{"t":"Label","n":"Label2","cap":"Produs, lucrare (comandă)","cs":"","rs":"","so":"","x":3461,"y":0,"w":3465,"h":793,"fs":12,"fw":400,"vis":true,"line":202,"ev":""},{"t":"Label","n":"Label3","cap":"Număr document .......................","cs":"","rs":"","so":"","x":0,"y":510,"w":1247,"h":853,"fs":10,"fw":400,"vis":true,"line":222,"ev":""},{"t":"Label","n":"Label5","cap":"Data","cs":"","rs":"","so":"","x":1247,"y":510,"w":2214,"h":283,"fs":11,"fw":400,"vis":true,"line":242,"ev":""},{"t":"Label","n":"Label6","cap":"Ziua","cs