<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <RootNamespace>VRC.Migrator</RootNamespace>
    <AssemblyName>VRC.Migrator</AssemblyName>
    <UseWindowsForms>true</UseWindowsForms>
    <!-- x64, NOT AnyCPU: the ACE provider is 64-bit only on this estate (same reason as KBot.Migrator / ADE.Migrator). -->
    <PlatformTarget>x64</PlatformTarget>
    <MyType>WindowsFormsWithCustomSubMain</MyType>
    <StartupObject>VRC.Migrator.Program</StartupObject>
    <OptionStrict>On</OptionStrict>
    <OptionExplicit>On</OptionExplicit>
    <OptionInfer>On</OptionInfer>
    <OptionCompare>Binary</OptionCompare>
  </PropertyGroup>

  <PropertyGroup>
    <FileVersion>0.3.11.0</FileVersion>
    <AssemblyVersion>1.0.0.0</AssemblyVersion>
  </PropertyGroup>

  <ItemGroup>
    <Import Include="System.Drawing" />
    <Import Include="System.Windows.Forms" />
    <Import Include="KBot.Theming" />
  </ItemGroup>

  <!-- Reads the VERCON Access files (tz_*.accdb) READ-ONLY and profiles them (SLICE-VC05-01). It writes nothing to Access.
       SLICE-VC05-02..05 add the plan and the single atomic transfer into MariaDB.
       TargetServer, TargetSchema and WriteOrder are reused from KBot.Migrator.
       expected_schema describes the Access source; import_map contains source conversion/remapping rules only. -->
  <ItemGroup>
    <PackageReference Include="System.Data.OleDb" Version="8.0.0" />
    <PackageReference Include="MySqlConnector" Version="2.6.2" />
    <PackageReference Include="Markdig" Version="0.45.0" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="expected_schema.json" LogicalName="VRC.Migrator.expected_schema.json" />
    <EmbeddedResource Include="import_map.json" LogicalName="VRC.Migrator.import_map.json" />
    <EmbeddedResource Include="VrcReportHtml.css" LogicalName="VRC.Migrator.VrcReportHtml.css" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\KBot.Common\KBot.Common.vbproj" />
    <ProjectReference Include="..\..\src\KBot.Theming\KBot.Theming.vbproj" />
    <ProjectReference Include="..\..\src\KBot.Controls\KBot.Controls.vbproj" />
    <ProjectReference Include="..\..\src\KBot.Migrator\KBot.Migrator.vbproj" />
  </ItemGroup>

</Project>
