# Slice 00EF-02. TEMPLATE ONLY: no real value in this file, in the repo, in a chat or in a ticket.
# On the VPS the real file is /etc/avacont/efactura.env  (owner root, mode 600), read by systemd
# through tools/efactura/efactura.conf. The values come from the application registered at ANAF
# (they are the five lines of token.txt inside the old token.zip: CID, SID, URI, ATH, TKN) plus
# one key made for this purpose. Restart the service after any change:
#   sudo systemctl restart avacont
# The server also needs the encryption library once:  pip install cryptography  (in the server's venv)
#
# Client id of the registered application                 (old token.txt: CID|)
EF_CLIENT_ID=
# Client secret. Secret. Stays on the server, never sent to a PC (old token.txt: SID|)
EF_CLIENT_SECRET=
# Redirect address registered at ANAF, EXACTLY as registered (old token.txt: URI|)
EF_REDIRECT_URI=
# ANAF authorise address (old token.txt: ATH|)
EF_AUTH_URL=
# ANAF token address (old token.txt: TKN|)
EF_TOKEN_URL=
# Key that encrypts the two tokens in AVACONT_COMUN.EF_Token. 32 random bytes, url-safe base64.
# Make it on the server:  python3 -c "import base64,os;print(base64.urlsafe_b64encode(os.urandom(32)).decode())"
# Keep a copy somewhere safe: if it is lost every unit has to do the certificate step again.
EF_TOKEN_KEY=
# How long a refresh token is assumed to live, in days, counted from the certificate step
# (to be confirmed in 00EF-03; the app warns 7 days before this runs out)
EF_REFRESH_DAYS=365
