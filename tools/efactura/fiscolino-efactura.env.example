# /etc/avacont/fiscolino-efactura.env, root:root, mode 0600.
# Se completează pe server. Baza de date folosită este FISCOLINO.
FISCOLINO_DB_HOST=
# Portul implicit este 3306.
FISCOLINO_DB_PORT=
FISCOLINO_DB_USER=
FISCOLINO_DB_PASSWORD=

FISCOLINO_EF_CLIENT_ID=
FISCOLINO_EF_CLIENT_SECRET=
# Valoarea înregistrată la ANAF: https://kbot.avatarsoft.ro/api/fiscolino/efactura/callback
FISCOLINO_EF_REDIRECT_URI=
# Cheie Fernet proprie, generată pe server cu cryptography.fernet.Fernet.generate_key().
FISCOLINO_EF_TOKEN_KEY=
