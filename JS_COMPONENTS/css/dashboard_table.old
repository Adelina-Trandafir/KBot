    .row-action-buttons {
        right: 4px;
        gap: 2px;
    }
    
    .row-action-btn {
        width: 20px;
        height: 20px;
        font-size: 10px;
    }
} */

/* ========== PANEL FILTRARE EXISTENT ========== */
.filter-panel {
    width: 280px;
    background: var(--bg-white);
    border-left: 2px solid var(--border-color);
    box-shadow: var(--shadow-sm);
    display: flex;
    flex-direction: column;
    transform: translateX(100%);
    transition: transform 0.3s ease;
    overflow: hidden;
}

.filter-panel.visible {
    transform: translateX(0);
}

.filter-header {
    background: var(--primary-gradient);
    color: white;
    padding: 12px 15px;
    display: flex;
    justify-content: space-between;
    align-items: center;
    font-weight: 600;
    font-size: 14px;
}

.filter-close {
    background: rgba(255, 255, 255, 0.2);
    border: 1px solid rgba(255, 255, 255, 0.3);
    color: white;
    padding: 4px 8px;
    border-radius: 3px;
    cursor: pointer;
    font-size: 16px;
    line-height: 1;
}

.filter-close:hover {
    background: rgba(255, 255, 255, 0.3);
}

.filter-content {
    padding: 20px;
    flex: 1;
    overflow-y: auto;
}

.filter-row {
    margin-bottom: 20px;
}

.filter-label {
    font-weight: 600;
    margin-bottom: 6px;
    font-size: 13px;
    color: var(--text-primary);
}

.filter-input,
.filter-select {
    width: 100%;
    padding: 8px 12px;
    border: 1px solid var(--border-color);
    border-radius: 4px;
    font-size: 13px;
    background: var(--bg-white);
}

.filter-input:focus,
.filter-select:focus {
    outline: none;
    border-color: #007bff;
    box-shadow: 0 0 0 2px rgba(0, 123, 255, 0.25);
}

.filter-actions {
    display: flex;
    gap: 10px;
    margin-top: 20px;
    padding-top: 20px;
    border-top: 1px solid var(--border-color);
}

.filter-btn {
    flex: 1;
    background: linear-gradient(135deg, #007bff, #0056b3);
    color: white;
    border: none;
    padding: 10px;
    border-radius: 4px;
    cursor: pointer;
    font-weight: 500;
    transition: all 0.3s;
}

.filter-btn:hover {
    background: linear-gradient(135deg, #0056b3, #004085);
    transform: translateY(-1px);
}

.filter-btn-clear {
    flex: 1;
    background: transparent;
    color: var(--text-secondary);
    border: 1px solid var(--border-color);
    padding: 10px;
    border-radius: 4px;
    cursor: pointer;
    font-weight: 500;
    transition: all 0.3s;
}

.filter-btn-clear:hover {
    background: var(--hover-bg);
    border-color: #adb5bd;
}

/* ========== RESPONSIVE PENTRU TABEL ========== */
@media (max-width: 1024px) {
    .filter-panel {
        width: 250px;
    }
}

@media (max-width: 768px) {
    .filter-panel {
        width: 100%;
        position: fixed;
        top: var(--header-height);
        right: 0;
        height: calc(100vh - var(--header-height));
        z-index: 2000;
        border-radius: 0;
    }
    
    .stat-item-small {
        font-size: 14px;
        padding: 6px 8px;
        min-height: 30px;
    }
    
    .table-footer {
        gap: 8px;
    }
    
    .footer-left,
    .footer-right {
        width: 100%;
        justify-content: space-around;
        display: flex;
        flex-direction: row;
        flex-wrap: nowrap;
        align-items: baseline;
    }
}

/* ========== STILURI PENTRU SORTARE COLOANE ========== */
.sortable-header {
    cursor: pointer;
    position: relative;
    user-select: none;
}

.sortable-header:hover {
    background: #e2e6ea !important;
}

.sort-indicator {
    position: absolute;
    right: 4px;
    top: 50%;
    transform: translateY(-50%);
    font-size: 10px;
    color: #6c757d;
}

.sort-asc .sort-indicator::after {
    content: '▲';
}

.sort-desc .sort-indicator::after {
    content: '🔽';
}

/* ========== STILURI PENTRU REDIMENSIONARE COLOANE ========== */
.resizable-header {
    position: relative;
}

.column-resizer {
    position: absolute;
    right: 0;
    top: 0;
    bottom: 0;
    width: 3px;
    cursor: col-resize;
    background: transparent;
    border-right: 1px solid var(--border-color);
}

.column-resizer:hover,
.column-resizer.resizing {
    background: #007bff;
    border-right-color: #007bff;
}

/* ========== STILURI PENTRU CĂUTARE ÎN TABEL ========== */
.table-search-highlight {
    background: #fff3cd !important;
    color: #856404 !important;
    font-weight: 600;
}

.table-search-current {
    background: #ffeaa7 !important;
    color: #2d3436 !important;
    font-weight: 700;
    box-shadow: 0 0 0 2px #fdcb6e;
}